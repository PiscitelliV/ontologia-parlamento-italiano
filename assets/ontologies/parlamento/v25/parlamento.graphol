              <object>
                <lexicalForm>Organo della Giunta delle elezioni e delle immunità del Senato eletto dalla Giunta stessa tra i propri componenti di opposizione. (art. 19 reg. S.), ne dirige i lavori e la discussione, nomina comitati per la revisione delle schede e la verifica delle incompatibilità (reg. verifica poteri)</lexicalForm>
                <datatype>None</datatype>
                <language>it</language>
              </object>
            </annotation>
          </annotations>
        </iri>
