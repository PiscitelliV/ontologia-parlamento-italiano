              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Legge pubblicata in Gazzetta Ufficiale al fine della sua entrata in vigore. Le leggi sono pubblicate subito dopo la promulgazione ed entrano in vigore il quindicesimo giorno successivo alla loro pubblicazione, salvo che le leggi stesse stabiliscano un termine diverso (Art. 73, c. 3 Cost.) </lexicalForm>
                <datatype>None</datatype>
                <language>it</language>
              </object>
            </annotation>
          </annotations>
