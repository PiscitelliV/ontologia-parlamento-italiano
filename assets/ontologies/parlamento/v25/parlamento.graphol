              <object>
                <lexicalForm>Incarico di rappresentanza politica in Parlamento conferito dagli elettori ai parlamentari (senatori e deputati); ogni membro del Parlamento rappresenta la Nazione ed esercita le sue funzioni senza vincolo di mandato (art. 67 Cost.).</lexicalForm>
                <datatype>None</datatype>
                <language>it</language>
              </object>
            </annotation>
          </annotations>
