              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Parlamentare membro del Senato votato con elezione a suffragio universale e diretto il cui mandato coincide con la durata della legislatura rispetto alla quale viene eletto.</lexicalForm>
                <datatype>None</datatype>
                <language>it</language>
              </object>
