        <iri>
          <value>https://w3id.org/italia/Parlamento/Camera</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/Parlamento/Camera</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
