              <subject>https://w3id.org/italia/Parlamento/OrganoCollegiale</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Organo collegiale</lexicalForm>
                <datatype>None</datatype>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/Parlamento/OrganoCollegiale</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Ufficio composto da una pluralità di persone e qualificato da una norma dell’ordinamento giuridico come idoneo ad esprimere la volontà dell'organizzazione cui appartiene e ad imputarle gli atti (con i relativi effetti) posti in essere collegialmente dai componenti dell’organo (persone fisiche).</lexicalForm>
                <datatype>None</datatype>
                <language>it</language>
              </object>
            </annotation>
          </annotations>
        </iri>
