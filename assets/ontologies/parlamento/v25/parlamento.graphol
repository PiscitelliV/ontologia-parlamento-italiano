              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Atto mediante il quale viene costituito un organo collegiale o monocratico della Camera e/o del Senato.</lexicalForm>
                <datatype>None</datatype>
                <language>it</language>
              </object>
            </annotation>
          </annotations>
        </iri>
        <iri>
          <value>https://w3id.org/italia/Parlamento/AttoDiIndirizzoEControlloPolitico</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/Parlamento/AttoDiIndirizzoEControlloPolitico</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Atto di indirizzo e controllo politico</lexicalForm>
                <datatype>None</datatype>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/Parlamento/AttoDiIndirizzoEControlloPolitico</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Atto mediante il quale il Parlamento esercita la funzione di indirizzo e di controllo politico sull’attività del Governo (mozione, risoluzione, ordine del giorno di istruzione, interpellanza e interrogazione)</lexicalForm>
                <datatype>None</datatype>
                <language>it</language>
              </object>
            </annotation>
          </annotations>
        </iri>
        <iri>
          <value>https://w3id.org/italia/Parlamento/AttoDiNomina</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/Parlamento/AttoDiNomina</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Atto di nomina</lexicalForm>
                <datatype>None</datatype>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/Parlamento/AttoDiNomina</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Atto attraverso il quale si conferisce ad un soggetto l’esercizio di determinate funzioni. Nell’ambito delle attività parlamentari, ad esempio, vengono nominati i componenti delle giunte, delle commissioni o dei comitati, i relatori.</lexicalForm>
                <datatype>None</datatype>
                <language>it</language>
              </object>
            </annotation>
          </annotations>
        </iri>
        <iri>
          <value>https://w3id.org/italia/Parlamento/AttoDiProceduraParlamentare</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/Parlamento/AttoDiProceduraParlamentare</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
