        <iri>
          <value>https://w3id.org/italia/Parlamento/senato</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/Parlamento/senato</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>senato</lexicalForm>
                <datatype>None</datatype>
                <language>it</language>
