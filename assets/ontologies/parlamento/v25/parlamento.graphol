        <iri>
          <value>https://w3id.org/italia/Parlamento/comitatoDeiNove</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/Parlamento/comitatoDeiNove</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
