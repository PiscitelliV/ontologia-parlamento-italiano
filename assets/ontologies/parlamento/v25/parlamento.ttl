#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#boolean
xsd:boolean rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#dateTime
xsd:dateTime rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#decimal
xsd:decimal rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#integer
xsd:integer rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#string
xsd:string rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/italia/Parlamento/aderisceAGruppo
odp:aderisceAGruppo rdf:type owl:ObjectProperty ;
                    rdfs:domain odp:Parlamentare ;
                    rdfs:range odp:AdesioneGruppo ;
                    rdfs:label "aderisce a gruppo"@it .


###  https://w3id.org/italia/Parlamento/approvaPropostaDiLegge
odp:approvaPropostaDiLegge rdf:type owl:ObjectProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( odp:EsameInAssemblea
                                                       odp:EsameInCommissione
                                                     )
                                       ] ;
                           rdfs:range [ rdf:type owl:Class ;
                                        owl:unionOf ( odp:PropostaDiLeggeApprovata
                                                      odp:PropostaDiLeggeApprovataConModificazioni
                                                      odp:PropostaDiLeggeApprovataDefinitivamente
                                                    )
                                      ] ;
                           rdfs:label "approva proposta di legge"@it .


###  https://w3id.org/italia/Parlamento/assegnatoInCommissione
odp:assegnatoInCommissione rdf:type owl:ObjectProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( odp:PropostaDiLeggeAssegnataInCommissione
                                                       odp:PropostaDiLeggeRiassegnataInCommissione
                                                     )
                                       ] ;
                           rdfs:range odp:AssegnazioneACommissione ;
                           rdfs:comment "assegnato (non ancora iniziato l'esame)"@it ;
                           rdfs:label "assegnato in commissione"@it .


###  https://w3id.org/italia/Parlamento/eleggeParlamentare
odp:eleggeParlamentare rdf:type owl:ObjectProperty ;
                       rdfs:domain odp:ElezioneDelParlamento ;
                       rdfs:range odp:Parlamentare ;
                       rdfs:label "elegge parlamentare"@it .


###  https://w3id.org/italia/Parlamento/elettoCon
odp:elettoCon rdf:type owl:ObjectProperty ,
                       owl:InverseFunctionalProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( odp:PresidenteDelSenato
                                          odp:PresidenteDellaCamera
                                        )
                          ] ;
              rdfs:range odp:VotazioneParlamentare ;
              rdfs:label "eletto con"@it .


###  https://w3id.org/italia/Parlamento/esegueEsameLegge
odp:esegueEsameLegge rdf:type owl:ObjectProperty ;
                     rdfs:domain odp:PresidenteDellaRepubblica ;
                     rdfs:range odp:EsameDelPresidenteDellaRepubblica ;
                     rdfs:label "esegue esame legge"@it .


###  https://w3id.org/italia/Parlamento/esprimeParereCommissione
odp:esprimeParereCommissione rdf:type owl:ObjectProperty ;
                             rdfs:domain odp:EsameInCommissione ;
                             rdfs:range odp:ParereSuPropostaLegge ;
                             rdfs:label "esprime parere commissione"@it .


###  https://w3id.org/italia/Parlamento/haArgomentoDiDocumento
odp:haArgomentoDiDocumento rdf:type owl:ObjectProperty ;
                           rdfs:domain odp:Documento ;
                           rdfs:range odp:ArgomentoDiDocumento ;
                           rdfs:label "ha argomento di documento"@it .


###  https://w3id.org/italia/Parlamento/haAssegnazioneSedeDiCommissione
odp:haAssegnazioneSedeDiCommissione rdf:type owl:ObjectProperty ;
                                    rdfs:domain odp:AssegnazioneACommissione ;
                                    rdfs:range [ rdf:type owl:Class ;
                                                 owl:unionOf ( odp:SedeConsultiva
                                                               odp:SedeLegislativaDeliberante
                                                               odp:SedeRedigente
                                                               odp:SedeReferente
                                                             )
                                               ] ;
                                    rdfs:label "ha assegnazione sede di Commissione"@it .


###  https://w3id.org/italia/Parlamento/haAssembleaGruppoParlamentareCamera
odp:haAssembleaGruppoParlamentareCamera rdf:type owl:ObjectProperty ,
                                                 owl:InverseFunctionalProperty ;
                                        rdfs:domain odp:GruppoParlamentareCamera ;
                                        rdfs:range odp:AssembleaGruppoParlamentareCamera ;
                                        rdfs:label "ha assemblea gruppo parlamentare camera"@it .


###  https://w3id.org/italia/Parlamento/haAssembleaGruppoParlamentareSenato
odp:haAssembleaGruppoParlamentareSenato rdf:type owl:ObjectProperty ,
                                                 owl:InverseFunctionalProperty ;
                                        rdfs:domain odp:GruppoParlamentareSenato ;
                                        rdfs:range odp:PresidenteGruppoParlamentareSenato ;
                                        rdfs:label "ha assemblea gruppo parlamentare senato"@it .


###  https://w3id.org/italia/Parlamento/haAttoDiConvalidaNominaMembro
odp:haAttoDiConvalidaNominaMembro rdf:type owl:ObjectProperty ;
                                  rdfs:domain odp:NominaDiMembroDelCollegio ;
                                  rdfs:range odp:AttoDiConvalidaNominaMembro ;
                                  rdfs:label "ha atto di convalida nomina membro"@it .


###  https://w3id.org/italia/Parlamento/haAttoDiCostituzioneOrgano
odp:haAttoDiCostituzioneOrgano rdf:type owl:ObjectProperty ,
                                        owl:InverseFunctionalProperty ;
                               rdfs:domain odp:Organo ;
                               rdfs:range odp:AttoDiCostituzioneOrgano ;
                               rdfs:label "ha atto di costituzione organo"@it .


###  https://w3id.org/italia/Parlamento/haAttoDiNominaDiMembroDelCollegio
odp:haAttoDiNominaDiMembroDelCollegio rdf:type owl:ObjectProperty ,
                                               owl:FunctionalProperty ;
                                      rdfs:domain odp:NominaDiMembroDelCollegio ;
                                      rdfs:range odp:AttoDiNomina ;
                                      rdfs:label "ha atto di nomina di membro del collegio"@it .


###  https://w3id.org/italia/Parlamento/haAttoDiNominaDiOrgano
odp:haAttoDiNominaDiOrgano rdf:type owl:ObjectProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:domain odp:TitolareOrganoMonocratico ;
                           rdfs:range odp:AttoDiNomina ;
                           rdfs:label "ha atto di nomina di organo"@it .


###  https://w3id.org/italia/Parlamento/haAutoreDiDocumento
odp:haAutoreDiDocumento rdf:type owl:ObjectProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain odp:Documento ;
                        rdfs:range odp:AutoreDiDocumento ;
                        rdfs:label "ha autore di documento"@it .


###  https://w3id.org/italia/Parlamento/haCategoriaDocumentoParlamentare
odp:haCategoriaDocumentoParlamentare rdf:type owl:ObjectProperty ;
                                     rdfs:domain odp:DocumentoParlamentare ;
                                     rdfs:range odp:CategoriaDocumentoParlamentare ;
                                     rdfs:label "ha categoria documento parlamentare"@it .


###  https://w3id.org/italia/Parlamento/haClassificazioneTeseo
odp:haClassificazioneTeseo rdf:type owl:ObjectProperty ;
                           rdfs:domain odp:TestoPropostaLegge ;
                           rdfs:range odp:Teseo ;
                           rdfs:label "ha classificazione teseo"@it .


###  https://w3id.org/italia/Parlamento/haCollegioNelPeriodo
odp:haCollegioNelPeriodo rdf:type owl:ObjectProperty ,
                                  owl:InverseFunctionalProperty ;
                         rdfs:domain odp:OrganoCollegiale ;
                         rdfs:range odp:CollegioNelPeriodo ;
                         rdfs:label "ha collegio nel periodo"@it .


###  https://w3id.org/italia/Parlamento/haCommissioneDiAssegnazione
odp:haCommissioneDiAssegnazione rdf:type owl:ObjectProperty ;
                                rdfs:domain odp:AssegnazioneACommissione ;
                                rdfs:range odp:CommissioneParlamentare ;
                                rdfs:label "ha commissione di assegnazione"@it .


###  https://w3id.org/italia/Parlamento/haCommissioneDiEsame
odp:haCommissioneDiEsame rdf:type owl:ObjectProperty ;
                         rdfs:domain odp:EsameInCommissione ;
                         rdfs:range odp:CommissioneParlamentare ;
                         rdfs:label "ha commissione di esame"@it .


###  https://w3id.org/italia/Parlamento/haContenutoDiDocumento
odp:haContenutoDiDocumento rdf:type owl:ObjectProperty ,
                                    owl:InverseFunctionalProperty ;
                           rdfs:domain odp:Documento ;
                           rdfs:range odp:ContenutoDiDocumento ;
                           rdfs:label "ha contenuto di documento"@it .


###  https://w3id.org/italia/Parlamento/haEsameDelPresidenteDellaRepubblica
odp:haEsameDelPresidenteDellaRepubblica rdf:type owl:ObjectProperty ;
                                        rdfs:domain odp:PropostaDiLeggeApprovataDefinitivamente ;
                                        rdfs:range odp:EsameDelPresidenteDellaRepubblica ;
                                        rdfs:label "ha esame del presidente della repubblica"@it .


###  https://w3id.org/italia/Parlamento/haEsameDiAssegnazioneInCommissione
odp:haEsameDiAssegnazioneInCommissione rdf:type owl:ObjectProperty ,
                                                owl:InverseFunctionalProperty ;
                                       rdfs:domain odp:AssegnazioneACommissione ;
                                       rdfs:range odp:EsameInCommissione ;
                                       rdfs:label "ha esame di assegnazione in commissione"@it .


###  https://w3id.org/italia/Parlamento/haEsameInSedutaAssembleaParlamentare
odp:haEsameInSedutaAssembleaParlamentare rdf:type owl:ObjectProperty ;
                                         rdfs:domain odp:EsameInAssemblea ;
                                         rdfs:range odp:SedutaCollegioParlamentare ;
                                         rdfs:label "ha esame in seduta assemblea parlamentare"@it .


###  https://w3id.org/italia/Parlamento/haEsameInSedutaCommissioneParlamentare
odp:haEsameInSedutaCommissioneParlamentare rdf:type owl:ObjectProperty ;
                                           rdfs:domain odp:EsameInCommissione ;
                                           rdfs:range odp:SedutaCollegioParlamentare ;
                                           rdfs:label "ha esame in seduta commissione parlamentare"@it .


###  https://w3id.org/italia/Parlamento/haEsitoVotazioneParlamentare
odp:haEsitoVotazioneParlamentare rdf:type owl:ObjectProperty ;
                                 rdfs:domain odp:VotazioneParlamentare ;
                                 rdfs:range odp:TipoEsitoVotazioneParlamentare ;
                                 rdfs:label "ha esito votazione parlamentare"@it .


###  https://w3id.org/italia/Parlamento/haFirmatario
odp:haFirmatario rdf:type owl:ObjectProperty ;
                 rdfs:domain odp:PropostaDiLegge ;
                 rdfs:range odp:Firmatario ;
                 rdfs:label "ha firmatario"@it .


###  https://w3id.org/italia/Parlamento/haFunzioneParlamentare
odp:haFunzioneParlamentare rdf:type owl:ObjectProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( odp:AdesioneGruppo
                                                       odp:NominaCaricaParlamentare
                                                     )
                                       ] ;
                           rdfs:range odp:FunzioneParlamentare ;
                           rdfs:label "ha funzione parlamentare"@it .


###  https://w3id.org/italia/Parlamento/haGruppoDiAdesione
odp:haGruppoDiAdesione rdf:type owl:ObjectProperty ;
                       rdfs:domain odp:AdesioneGruppo ;
                       rdfs:range odp:GruppoParlamentare ;
                       rdfs:label "ha gruppo di adesione"@it .


###  https://w3id.org/italia/Parlamento/haGruppoInLegislatura
odp:haGruppoInLegislatura rdf:type owl:ObjectProperty ;
                          rdfs:domain odp:Legislatura ;
                          rdfs:range odp:GruppoParlamentare ;
                          rdfs:label "ha gruppo in legislatura"@it .


###  https://w3id.org/italia/Parlamento/haInterventoSuPropostaDiLegge
odp:haInterventoSuPropostaDiLegge rdf:type owl:ObjectProperty ;
                                  rdfs:domain odp:LetturaPropostaDiLegge ;
                                  rdfs:range odp:InterventoSuPropostaDiLegge ;
                                  rdfs:label "ha intervento su proposta di legge"@it .


###  https://w3id.org/italia/Parlamento/haLetturaPropostaDiLegge
odp:haLetturaPropostaDiLegge rdf:type owl:ObjectProperty ;
                             rdfs:domain odp:PropostaDiLeggeInLettura ;
                             rdfs:range odp:LetturaPropostaDiLegge ;
                             rdfs:label "ha lettura proposta di legge"@it .


###  https://w3id.org/italia/Parlamento/haMembroDelCollegio
odp:haMembroDelCollegio rdf:type owl:ObjectProperty ,
                                 owl:InverseFunctionalProperty ;
                        rdfs:domain odp:CollegioNelPeriodo ;
                        rdfs:range odp:MembroDelCollegio ;
                        rdfs:label "ha membro del collegio"@it .


###  https://w3id.org/italia/Parlamento/haNaturaPropostaDiLegge
odp:haNaturaPropostaDiLegge rdf:type owl:ObjectProperty ;
                            rdfs:domain odp:PropostaDiLegge ;
