odp:TipoDiFinalitàDocumentoParlamentare rdf:type owl:Class ;
                                        rdfs:label "Tipo di finalità documento parlamentare"@it .


###  https://w3id.org/italia/Parlamento/TipoDiVotazioneParlamentare
odp:TipoDiVotazioneParlamentare rdf:type owl:Class ;
                                rdfs:label "Tipo di votazione parlamentare"@it .


###  https://w3id.org/italia/Parlamento/TipoEsitoVotazioneParlamentare
odp:TipoEsitoVotazioneParlamentare rdf:type owl:Class ;
                                   rdfs:comment "Risultato di una deliberazione di un Organo parlamentare. "@it ;
                                   rdfs:label "Tipo esito votazione parlamentare"@it .


###  https://w3id.org/italia/Parlamento/TipoFirmatario
odp:TipoFirmatario rdf:type owl:Class ;
                   rdfs:subClassOf skos:Concept ;
                   rdfs:label "Tipo firmatario"@it .


###  https://w3id.org/italia/Parlamento/TipoFunzioneParlamentare
odp:TipoFunzioneParlamentare rdf:type owl:Class ;
                             rdfs:subClassOf skos:Concept ;
                             rdfs:label "Tipo funzione parlamentare"@it .


###  https://w3id.org/italia/Parlamento/TipoSedutaCollegioParlamentare
odp:TipoSedutaCollegioParlamentare rdf:type owl:Class ;
                                   rdfs:subClassOf skos:Concept ;
                                   rdfs:label "Tipo seduta collegio parlamentare"@it .


###  https://w3id.org/italia/Parlamento/TitolareOrganoMonocratico
odp:TitolareOrganoMonocratico rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Restriction ;
                                                    owl:onProperty odp:haAttoDiNominaDiOrgano ;
                                                    owl:someValuesFrom owl:Thing
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty odp:haPeriodoDiTitolarità ;
                                                    owl:someValuesFrom owl:Thing
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty odp:èTitolareOrganoMonocratico ;
                                                    owl:someValuesFrom owl:Thing
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty [ owl:inverseOf odp:haTitolareOrganoNelPeriodo
                                                                   ] ;
                                                    owl:someValuesFrom owl:Thing
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty odp:dataNominaTitolareOrganoMonocratico ;
                                                    owl:someValuesFrom rdfs:Literal
                                                  ] ;
                              rdfs:label "Titolare organo monocratico"@it .


###  https://w3id.org/italia/Parlamento/TitoloCommissione
odp:TitoloCommissione rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty odp:dataInizioValiditaTitoloCommissione ;
                                            owl:someValuesFrom rdfs:Literal
                                          ] ;
                      rdfs:label "Titolo commissione"@it .


###  https://w3id.org/italia/Parlamento/TitoloProposta
odp:TitoloProposta rdf:type owl:Class ;
                   rdfs:label "Titolo proposta"@it .


###  https://w3id.org/italia/Parlamento/TrasposizioneDirettivaUE
odp:TrasposizioneDirettivaUE rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Restriction ;
                                                   owl:onProperty odp:haRecepimentoDirettivaUE ;
                                                   owl:someValuesFrom owl:Thing
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty odp:dataScadenzaTrasposizioneUE ;
                                                   owl:someValuesFrom rdfs:Literal
                                                 ] ;
                             rdfs:subClassOf odp:ProceduraParlamentare ;
                             rdfs:label "Trasposizione direttiva UE"@it .


###  https://w3id.org/italia/Parlamento/UltimaLettura
odp:UltimaLettura rdf:type owl:Class ;
                  rdfs:comment "Ultimo esame di una proposta di legge da parte di una delle due Camere parlamentari che la approva definitivamente."@it ;
                  rdfs:label "Ultima lettura"@it .


###  https://w3id.org/italia/Parlamento/VotazioneConSchedaDiPreferenza
odp:VotazioneConSchedaDiPreferenza rdf:type owl:Class ;
                                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                                         owl:onProperty [ owl:inverseOf odp:haVotazioneConSchedaDiPreferenza
                                                                        ] ;
                                                         owl:someValuesFrom owl:Thing
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty odp:ordineVotazioneConScheda ;
                                                         owl:someValuesFrom rdfs:Literal
                                                       ] ;
                                   rdfs:label "Votazione con scheda di preferenza"@it .


###  https://w3id.org/italia/Parlamento/VotazioneParlamentare
odp:VotazioneParlamentare rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                owl:onProperty odp:haParlamentarePartecipanteAlVoto ;
                                                owl:someValuesFrom owl:Thing
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty odp:haTipoDiVotazione ;
                                                owl:someValuesFrom owl:Thing
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty [ owl:inverseOf odp:haVotazioneCollegioParlamentare
                                                               ] ;
                                                owl:someValuesFrom owl:Thing
                                              ] ;
                          rdfs:subClassOf TI:TimeInstant ;
                          rdfs:comment """Manifestazione della volontà da parte di un parlamentare nell’ambito di una seduta dell’Assemblea di appartenenza. A seconda della modalità in cui viene effettuata, la votazione può essere: 
-	nominale se consente la verifica del numero legale e di conoscere il voto di ciascun parlamentare votante;
-	ad alzata di mano se non consente la verifica del numero legale;
-	a scrutinio segreto se consente la verifica del numero legale, ma non consente di conoscere il voto di ciascun parlamentare votante; 
-	a scrutinio palese se consente di conoscere il voto di ciascun parlamentare votante.
Spetta al Presidente dell’Assemblea stabilire l'ordine delle votazioni, indirle e proclamarne i risultati.
"""@it ;
                          rdfs:label "Votazione parlamentare"@it .


