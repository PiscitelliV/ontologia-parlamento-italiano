###  https://w3id.org/italia/Parlamento/AssembleaGruppoParlamentare
odp:AssembleaGruppoParlamentare rdf:type owl:NamedIndividual ,
                                         odp:Organo .


###  https://w3id.org/italia/Parlamento/PresidenteGruppoParlamentare
odp:PresidenteGruppoParlamentare rdf:type owl:NamedIndividual ,
                                          odp:Organo .


###  https://w3id.org/italia/Parlamento/assembleaParlamentare
odp:assembleaParlamentare rdf:type owl:NamedIndividual ,
                                   odp:OrganoParlamentare ;
                          rdfs:comment "Organo collegiale della Camera e del Senato, composto rispettivamente da deputati e senatori eletti per la legislatura in corso, che provvede su:"@it ;
                          rdfs:label "assemblea parlamentare"@it .


###  https://w3id.org/italia/Parlamento/camera
odp:camera rdf:type owl:NamedIndividual ,
                    odp:OrganoCostituzionale ;
           rdfs:comment "Organo collegiale del Parlamento cui spetta, collettivamente e alla pari con il Senato, l’esercizio del potere legislativo (art. 70 Cost.). La Camera dei deputati è eletta a suffragio universale e diretto. Il numero dei deputati è di quattrocento, otto dei quali eletti nella circoscrizione Estero (art. 56 Cost.)."@it ;
           rdfs:label "camera"@it .


###  https://w3id.org/italia/Parlamento/collegioQuestori
odp:collegioQuestori rdf:type owl:NamedIndividual ,
                              odp:OrganoParlamentare ;
                     rdfs:comment "Organo collegiale della Camera (artt. 5, 10 reg.C.) e del Senato (art. 5 reg.S) composto da 3 membri e con attribuzioni in materia di: progetto di bilancio e conto consuntivo; spese e servizi; cerimoniale (artt. 10 reg.C., 10 reg.S.)."@it ;
                     rdfs:label "collegio questori"@it .


###  https://w3id.org/italia/Parlamento/comitatoDeiNove
odp:comitatoDeiNove rdf:type owl:NamedIndividual ,
                             odp:OrganoParlamentare ;
                    rdfs:comment "Organo di commissione in sede referente della Camera composto in modo da garantire la partecipazione proporzionale delle minoranze e nominato dalla commissione stessa per la discussione davanti all'Assemblea, nonché per esaminare i nuovi emendamenti, gli articoli aggiuntivi ed eventuali subemendamenti presentati direttamente in Assemblea (artt. 79 e 86 reg.C.)."@it ;
                    rdfs:label "comitato dei nove"@it .


###  https://w3id.org/italia/Parlamento/comitatoLegislazione
odp:comitatoLegislazione rdf:type owl:NamedIndividual ,
                                  odp:OrganoParlamentare ;
                         rdfs:comment "Organo collegiale sia della Camera, sia del Senato composto, rispettivamente, da dieci deputati (art. 16 bis reg.C.) e da otto senatori (art. 20 bis reg.S.) che, su richiesta della commissione competente, esprime pareri sui progetti di legge esaminati dalla stessa commissione."@it ;
                         rdfs:label "comitato legislazione"@it .


###  https://w3id.org/italia/Parlamento/comitatoRistretto
odp:comitatoRistretto rdf:type owl:NamedIndividual ,
                               odp:OrganoParlamentare ;
                      rdfs:comment """Organo di commissione (permanente o speciale) in sede referente nominato dalla commissione stessa e composto in modo da garantire la partecipazione della minoranza (artt. 79 reg.C., 43 reg.S.). 
Al comitato ristretto viene affidato l'ulteriore svolgimento dell'istruttoria e la formulazione delle proposte relative al testo degli articoli del progetto di legge (art. 79 reg.C.) ovvero la redazione definitiva del testo del disegno di legge (art. 43 reg.S.)."""@it ;
                      rdfs:label "comitato ristretto"@it .


###  https://w3id.org/italia/Parlamento/commissioneQuestioniRegionali
odp:commissioneQuestioniRegionali rdf:type owl:NamedIndividual ,
                                           odp:OrganoParlamentare ;
                                  rdfs:comment """Organo parlamentare bicamerale con funzioni consultive obbligatorie nel caso di scioglimento del Consiglio regionale e la rimozione del Presidente della Giunta che abbiano compiuto atti contrari alla Costituzione o gravi violazioni di legge o per ragioni di sicurezza nazionale (art. 126 Cost.). La Commissione questioni regionali esprime: 
- parere sui disegni di legge che contengano disposizioni nelle materie indicate dall’articolo 117 Cost. e in quelle previste dagli statuti speciali delle Regioni adottati con leggi costituzionali, o che riguardino l’attivita legislativa o amministrativa delle Regioni (artt. 102 reg.C.: 40 reg.S.);
- osservazioni sul documento di economia e finanza (artt. 118-bis reg.C.; 125-bis reg.S.).
- parere sulle questioni di merito promosse davanti alla Camere su una legge regionale per contrasto di interessi (art. 102 reg.C.)."""@it ;
                                  rdfs:label "commissione questioni regionali"@it .


###  https://w3id.org/italia/Parlamento/consiglioPresidenzaSenato
odp:consiglioPresidenzaSenato rdf:type owl:NamedIndividual ,
                                       odp:OrganoParlamentare ;
                              rdfs:comment """Organo collegiale di direzione del Senato con le attribuzioni di cui all’art. 12 reg.S.; è l’Ufficio di presidenza del Senato ed è presieduto dal Presidente del Senato e composto (artt. 68 Cost.; 5 e 12 reg.S.):
•	dai quattro Vicepresidenti;
•	dai tre senatori Questori;
•	da otto senatori Segretari.
 Il CdP delibera il progetto di bilancio del Senato, le variazioni degli stanziamenti dei capitoli e del conto consuntivo; approva il Regolamento della biblioteca e il Regolamento dell’archivio storico del Senato; adotta il codice di condotta dei senatori e delibera le sanzioni proposte dal Presidente nei confronti dei senatori per le condotte tenute in Assemblea; nomina, su proposta del Presidente, il Segretario Generale del Senato; approva il Regolamenti interni dell’Amministrazione del Senato.
Il CdP rimane in carica fino alla prima riunione della nuova Assemblea. (art. 12 reg.S.)"""@it ;
                              rdfs:label "consiglio presidenza senato"@it .


###  https://w3id.org/italia/Parlamento/giuntaAutorizzazioniCamera
odp:giuntaAutorizzazioniCamera rdf:type owl:NamedIndividual ,
                                        odp:OrganoParlamentare ;
                               rdfs:comment """Organo della Camera dei deputati composto da 21 deputati nominati dal Presidente della Camera e costituito per riferire all’Assemblea entro 30 giorni sulle richieste di sottoposizione a procedimento penale e sui provvedimenti comunque coercitivi della libertà personale o domiciliare riguardanti deputati.
Per ciascun caso la Giunta formula, con relazione, proposta di concessione o di diniego dell'autorizzazione. (Art. 18 reg.C.)"""@it ;
                               rdfs:label "giunta autorizzazioni camera"@it .


###  https://w3id.org/italia/Parlamento/giuntaElezioniCamera
odp:giuntaElezioniCamera rdf:type owl:NamedIndividual ,
                                  odp:OrganoParlamentare ;
                         rdfs:comment "Organo della Camera composto da 30 deputati nominati dal Presidente che riferisce all’Assemblea, non oltre diciotto mesi dalle elezioni, sulla regolarità delle operazioni elettorali, sui titoli di ammissione dei deputati e sulle cause di ineleggibilità, di incompatibilità e di decadenza previste dalla legge, formulando le relative proposte di convalida, annullamento o decadenza. (art. 17 reg.C.)"@it ;
                         rdfs:label "giunta elezioni camera"@it .


###  https://w3id.org/italia/Parlamento/giuntaElezioniImmunitaSenato
odp:giuntaElezioniImmunitaSenato rdf:type owl:NamedIndividual ,
                                          odp:OrganoParlamentare ;
                                 rdfs:comment """Organo del Senato composto da 19 senatori che: 
- verifica i titoli di ammissione dei senatori e delle cause sopraggiunte di ineleggibilità e di incompatibilità; 
- esamina le richieste di autorizzazione a procedere ai sensi dell’art. 68 Cost.; 
- riferisce all’Assemblea sulle richieste di autorizzazione a procedere nei confronti del Presidente del Consiglio dei ministri e dei ministri. (art. 17 reg.S.)"""@it ;
                                 rdfs:label "giunta elezioni immunita senato"@it .


###  https://w3id.org/italia/Parlamento/giuntaRegolamento
odp:giuntaRegolamento rdf:type owl:NamedIndividual ,
                               odp:OrganoParlamentare ;
                      rdfs:comment "Organo collegiale della Camera (art. 16 reg.C.) e del Senato (art. 18 reg.S.) competente a esaminare le proposte di modifica del Regolamento (rispettivamente, di Camera e Senato) e a rilasciare pareri sulla sua interpretazione."@it ;
                      rdfs:label "giunta regolamento"@it .


###  https://w3id.org/italia/Parlamento/governo
odp:governo rdf:type owl:NamedIndividual ,
                     odp:OrganoCostituzionale ;
            rdfs:comment "Organo dello Stato titolare del potere esecutivo, del potere di iniziativa legislativa, del potere di adottare decreti-legge e approvare decreti-legislativi, del potere regolamentare; è composto dal Presidente del Consiglio dei ministri, dai singoli ministri e dal Consiglio dei ministri (artt. 93 Cost., 1, legge n. 400/1988)."@it ;
            rdfs:label "governo"@it .


###  https://w3id.org/italia/Parlamento/organoGiurisdizionaleCamera
odp:organoGiurisdizionaleCamera rdf:type owl:NamedIndividual ,
                                         odp:OrganoParlamentare ;
                                rdfs:comment """Organo con potere di decidere in merito alle controversie. Sono organi giurisdizionali: 
-il Consiglio di giurisdizione e la Sezione giurisdizionale dell’Ufficio di Presidenza che decidono, rispettivamente in primo grado e in sede di appello, sui ricorsi e qualsiasi impugnativa, anche presentata da soggetti estranei alla Camera, avverso gli atti di amministrazione della Camera medesima, ad eccezione di quelli concernenti lo stato giuridico, il trattamento economico e di quiescenza e la disciplina dei dipendenti della Camera, ivi compresi i doveri relativi al segreto di ufficio, per i quali si applica il regolamento per la tutela giurisdizionale dei dipendenti della Camera (artt. 12 reg.C; 1 ss. reg. tutela giurisdizionale C.); 
-la Commissione giurisdizionale per il personale; 
- il Collegio d’appello."""@it ;
                                rdfs:label "organo giurisdizionale camera"@it .


###  https://w3id.org/italia/Parlamento/parlamento
odp:parlamento rdf:type owl:NamedIndividual ,
                        odp:OrganoCostituzionale ;
               rdfs:comment """Organo collegiale bicamerale dello Stato titolare del potere legislativo (e altre prerogative previste dalla Costituzione); è direttamente rappresentativo in quanto eletto dal corpo elettorale. Il Parlamento si compone della Camera dei deputati e del Senato della Repubblica che esercitano collettivamente e alla pari la funzione legislativa (artt. 55 e 70 Cost.).
La Camera dei deputati e il Senato della Repubblica sono eletti per cinque anni (art. 60 Cost.)."""@it ;
               rdfs:label "parlamento"@it .


###  https://w3id.org/italia/Parlamento/presidenteConsiglioMinistri
odp:presidenteConsiglioMinistri rdf:type owl:NamedIndividual ,
                                         odp:OrganoCostituzionale ;
                                rdfs:comment "Organo del Governo della Repubblica nominato dal Presidente della Repubblica (art. 92 Cost.) che dirige la politica generale del Governo e ne è responsabile; mantiene l'unità di indirizzo politico ed amministrativo, promuovendo e coordinando l'attività dei ministri (art. 95 Cost.; per un’elencazione delle attribuzioni, art. 5 legge 400/88)."@it ;
                                rdfs:label "presidente consiglio ministri"@it .


###  https://w3id.org/italia/Parlamento/presidenteDelSenato
odp:presidenteDelSenato rdf:type owl:NamedIndividual ,
                                 odp:OrganoParlamentare ;
                        rdfs:comment "Organo monocratico del Senato eletto con votazione a scrutinio segreto (art. 4 reg.S.) che rappresenta il Senato e regola l’attività dei suoi organi, dirige la discussione e mantiene l’ordine, giudica della ricevibilità dei testi, concede la facoltà di parlare, pone le questioni, stabilisce l’ordine delle votazioni e ne proclama i risultati. Sovrintende alle funzioni attribuite ai Questori ed ai Segretari. Assicura, impartendo le necessarie direttive, il buon andamento dell’Amministrazione del Senato (artt. 68 Cost., 8 reg.S.)."@it ;
                        rdfs:label "presidente del senato"@it .


###  https://w3id.org/italia/Parlamento/presidenteDellaCamera
odp:presidenteDellaCamera rdf:type owl:NamedIndividual ,
                                   odp:OrganoParlamentare ;
                          rdfs:comment """Organo monocratico della Camera eletto a scrutinio segreto che provvede a: rappresentare la Camera, assicurare il buon andamento dei suoi lavori facendo osservare il Regolamento; 
dare la parola, dirigere e moderare la discussione, mantenere l'ordine, porre le questioni, stabilire l'ordine delle votazioni, chiarire il significato del voto e annunziarne il risultato (artt. 63 Cost.; 8 reg.C.);
presiedere l’Assemblea, l’Ufficio di Presidenza, la Conferenza dei Presidenti di Gruppo, la Giunta per il regolamento (art. 16 reg.C.)."""@it ;
                          rdfs:label "presidente della camera"@it .


###  https://w3id.org/italia/Parlamento/presidenteDellaRepubblica
odp:presidenteDellaRepubblica rdf:type owl:NamedIndividual ,
                                       odp:OrganoCostituzionale ;
                              rdfs:comment """Organo monocratico dello Stato, eletto a scrutinio segreto dal Parlamento in seduta comune integrato dai delegati delle Regioni, che provvede a:
- esercitare i poteri di cui all’art. 87 Cost., tra cui indire le elezioni e i referendum;
- sciogliere le Camere (art. 88 Cost.);
- promulgare le leggi con potere di rinvio (art. 73 Cost.);
- nominare il Presidente del Consiglio dei ministri (art. 92 Cost.);
- nominare 5 membri della Corte costituzionale (art. 135 Cost.);
- nominare 5 senatori a vita (art. 56 Cost.). 
Dura in carica sette anni (art. 85 Cost.) ed è rieleggibile."""@it ;
                              rdfs:label "presidente della repubblica"@it .


###  https://w3id.org/italia/Parlamento/presidenteGiuntaElezioniCamera
odp:presidenteGiuntaElezioniCamera rdf:type owl:NamedIndividual ,
                                            odp:OrganoParlamentare ;
                                   rdfs:comment """Organo della Giunta per le elezioni della Camera eletto dalla Giunta stessa (art. 17, reg. C.; art. 1, reg. Giunta elezioni) e che provvede a:
- nominare i membri della giunta che formano il Comitato permanente per le incompatibilità, le ineleggibilità e le decadenze, nonché degli altri due comitati istituiti dalla Giunta stessa (art. 3, reg. Giunta elezioni);
- nominare comitato di verifica per la revisione delle schede elettorali, (art. 3, reg.  Giunta elezioni);
- nominare un Relatore per la verifica dei poteri (artt. 10 e 11, reg. Giunta elezioni).
Qualora la giunta deliberi la contestazione di un’elezione, egli fissa il giorno della seduta pubblica, dirige la discussione, disciplina l’udienza e comunica in seduta pubblica la deliberazione assunta (Art. 1, reg. Giunta elezioni)."""@it ;
                                   rdfs:label "presidente giunta elezioni camera"@it .


###  https://w3id.org/italia/Parlamento/presidenteGiuntaElezioniEImmunitaSenato
odp:presidenteGiuntaElezioniEImmunitaSenato rdf:type owl:NamedIndividual ,
                                                     odp:OrganoParlamentare ;
                                            rdfs:comment "Organo della Giunta delle elezioni e delle immunità del Senato eletto dalla Giunta stessa tra i propri componenti di opposizione. (art. 19 reg. S.), ne dirige i lavori e la discussione, nomina comitati per la revisione delle schede e la verifica delle incompatibilità (reg. verifica poteri)"@it ;
                                            rdfs:label "presidente giunta elezioni e immunita senato"@it .


###  https://w3id.org/italia/Parlamento/senato
odp:senato rdf:type owl:NamedIndividual ,
                    odp:OrganoCostituzionale ;
           rdfs:comment """Organo collegiale del Parlamento cui spetta, collettivamente e alla pari con la Camera dei deputati, l’esercizio del potere legislativo (art. 70 Cost.) ovvero poteri di indirizzo, di controllo, di inchiesta e di natura giurisdizionale. Il Senato della Repubblica è eletto a base regionale, salvi i seggi assegnati alla circoscrizione Estero. Il numero dei senatori elettivi a suffragio universale e diretto è di duecento, quattro dei quali eletti nella circoscrizione Estero. (artt. 57 e 58 Cost.).
Il Senato è eletto per cinque anni (art. 60 Cost.)."""@it ;
           rdfs:label "senato"@it .


###  https://w3id.org/italia/Parlamento/ufficioPresidenzaCamera
odp:ufficioPresidenzaCamera rdf:type owl:NamedIndividual ,
                                     odp:OrganoParlamentare ;
                            rdfs:comment """Organo collegiale di direzione della Camera dei deputati con le attribuzioni di cui all’art. 12 reg.C.; è presieduto dal Presidente della Camera e composto:
•	dai quattro Vicepresidenti;
•	dai tre deputati Questori;
•	da almeno otto deputati Segretari (il numero dei deputati Segretari può essere elevato al fine di consentire la presenza di tutti i Gruppi parlamentari nell'Ufficio di Presidenza. (artt. 68 Cost.; 5 e 12 reg.C.)
L’UdP resta in carica, quando viene rinnovata la Camera, fino alla prima riunione della nuova Assemblea.
L’UdP delibera il progetto di bilancio preventivo e il rendiconto consuntivo della Camera predisposti dai Questori; decide i ricorsi circa la costituzione o la prima convocazione dei Gruppi, nonché i ricorsi dei Gruppi sulla composizione delle Commissioni parlamentari; approva il regolamento della biblioteca della Camera e vigila sul suo funzionamento attraverso un apposito comitato; adotta regolamenti; nomina Segretario generale Camera; applica le sanzioni proposte dal Presidente nei confronti dei deputati per condotte tenute in Assemblea (artt. 12 e 60 reg.C.)."""@it ;
                            rdfs:label "ufficio presidenza camera"@it .


###  https://w3id.org/italia/Parlamento/votazioneConSchedaDiPreferenza
odp:votazioneConSchedaDiPreferenza rdf:type owl:NamedIndividual ,
                                            odp:TipoDiVotazioneParlamentare ;
                                   rdfs:label "votazione con scheda di preferenza"@it .


#################################################################
#    Annotations
#################################################################

odp:AssembleaGruppoParlamentare rdfs:comment "Organo del gruppo parlamentare che ne approva il regolamento (“statuto” alla Camera, art. 15 reg.C.) ed è competente, in ogni caso, ad approvare il rendiconto del Gruppo e indicare l'organo responsabile per la gestione amministrativa e contabile del Gruppo. (artt. 15 reg.C.; 15 c.3-bis, c.3-ter reg.S.)"@it ;
                                rdfs:label "Assemblea gruppo parlamentare"@it .


odp:PresidenteGruppoParlamentare rdfs:comment "Organo del gruppo parlamentare nominato nella prima riunione (artt. 15, comma 2, reg.C., 15, comma 2, reg.S.) che ha il potere di rappresentare il gruppo. Il presidente di gruppo può presentare questioni pregiudiziali o sospensive su progetti di legge di conversione di decreti legge (art.78, comma 3, reg.S)."@it ;
                                 rdfs:label "Presidente gruppo parlamentare"@it .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:Class ;
  owl:unionOf ( odp:PresidenteDelSenato
                odp:PresidenteDellaCamera
              ) ;
  owl:equivalentClass [ rdf:type owl:Restriction ;
                        owl:onProperty odp:elettoCon ;
                        owl:someValuesFrom owl:Thing
                      ]
] .


[ rdf:type owl:Restriction ;
  owl:onProperty odp:haTipoDiVotazione ;
  owl:someValuesFrom [ rdf:type owl:Class ;
                       owl:oneOf ( odp:votazioneConSchedaDiPreferenza
                                 )
                     ] ;
  owl:equivalentClass [ rdf:type owl:Restriction ;
                        owl:onProperty odp:haVotazioneConSchedaDiPreferenza ;
                        owl:someValuesFrom owl:Thing
                      ]
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:AssembleaGruppoParlamentare
                odp:AssembleaParlamentare
                odp:CommissioneParlamentare
                odp:GiuntaParlamentare
              ) ;
  rdfs:subClassOf odp:CollegioParlamentare
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:AttoDiAttivitàCollegiale
                odp:AttoDiIndirizzoEControlloPolitico
                odp:AttoDiProceduraParlamentare
              ) ;
  rdfs:subClassOf odp:AttoParlamentare
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:Bollettino
                odp:CalendarioDeiLavori
                odp:OrdineDelGiornoDellaSeduta
                odp:ProcessoVerbale
                odp:ProgrammaDeiLavori
                odp:Resoconto
              ) ;
  rdfs:subClassOf odp:AttoDiAttivitàCollegiale
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:Camera
                odp:Senato
              ) ;
  rdfs:subClassOf odp:OrganoComplessoNelPeriodo
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:CommissioneBicamerale
                odp:CommissionePermanente
                odp:CommissioneSpeciale
              ) ;
  rdfs:subClassOf odp:CommissioneParlamentare
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:CommissionePermanenteCamera
                odp:CommissionePermanenteSenato
              ) ;
  rdfs:subClassOf odp:CommissionePermanente
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:CommissioneSpecialeCamera
                odp:CommissioneSpecialeSenato
              ) ;
  rdfs:subClassOf odp:CommissioneSpeciale
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:ConclusoEsameCommissione
                odp:PropostaDiLeggeAssegnataInCommissione
                odp:PropostaDiLeggeInCorsoDiEsameInCommissione
                odp:PropostaDiLeggeRiassegnataInCommissione
                odp:PropostaDiLeggeRimessaAdAssemblea
              ) ;
  rdfs:subClassOf odp:PropostaDiLeggeInLettura
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:DocumentoExtraParlamentare
                odp:DocumentoParlamentare
              ) ;
  rdfs:subClassOf odp:Documento
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:Emendamento
                odp:Parere
                odp:PropostaDiLegge
                odp:Relazione
              ) ;
  rdfs:subClassOf odp:AttoDiProceduraParlamentare
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:GruppoParlamentareCamera
                odp:GruppoParlamentareSenato
              ) ;
  rdfs:subClassOf odp:GruppoParlamentare
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:Interpellanza
                odp:Interrogazione
                odp:Mozione
                odp:OrdineDelGiornoDiIstruzioneAlGoverno
                odp:Risoluzione
              ) ;
  rdfs:subClassOf odp:AttoDiIndirizzoEControlloPolitico
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:LeggePubblicataInGazzettaUfficiale
                odp:PropostaDiLeggeApprovata
                odp:PropostaDiLeggeApprovataConModificazioni
                odp:PropostaDiLeggeApprovataDefinitivamente
                odp:PropostaDiLeggeInLettura
                odp:PropostaDiLeggeRinviata
              ) ;
  rdfs:subClassOf odp:StatoPropostaDiLegge
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:LegislaturaCamera
                odp:LegislaturaSenato
              ) ;
  rdfs:subClassOf odp:Legislatura
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:MembroDelGoverno
                odp:Parlamentare
                odp:Regione
              ) ;
  rdfs:subClassOf odp:Firmatario
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:OrganoCostituzionale
                odp:OrganoParlamentare
              ) ;
  rdfs:subClassOf odp:Organo
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:PresidenteCommissioneParlamentare
                odp:PresidenteDelSenato
                odp:PresidenteDellaCamera
                odp:PresidenteGiuntaParlamentare
                odp:PresidenteGruppoParlamentare
              ) ;
  rdfs:subClassOf odp:PresidenteDiCollegioParlamentare
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:PrimaLettura
                odp:UltimaLettura
              ) ;
  rdfs:subClassOf odp:LetturaPropostaDiLegge
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:PropostaDiLeggeApprovata
                odp:PropostaDiLeggeRinviata
              ) ;
  rdfs:subClassOf [ rdf:type owl:Restriction ;
                    owl:onProperty odp:haStatoDiPropostaDiLeggePrecedente ;
                    owl:someValuesFrom odp:PropostaDiLeggeInLettura
                  ]
] .


[ rdf:type owl:Class ;
  owl:unionOf ( odp:RelatoreDiMaggioranza
                odp:RelatoreDiMinoranza
              ) ;
  rdfs:subClassOf odp:Relatore
] .


[ rdf:type owl:Restriction ;
  owl:onProperty TI:fallsInside ;
  owl:someValuesFrom odp:VotazioneParlamentare ;
  rdfs:subClassOf odp:Legislatura
] .


[ rdf:type owl:Restriction ;
  owl:onProperty [ owl:inverseOf odp:haAttoDiNominaDiMembroDelCollegio
                 ] ;
  owl:someValuesFrom [ rdf:type owl:Restriction ;
                       owl:onProperty [ owl:inverseOf odp:haNominaDiMembroDelCollegio
                                      ] ;
                       owl:someValuesFrom [ rdf:type owl:Restriction ;
                                            owl:onProperty [ owl:inverseOf odp:haMembroDelCollegio
                                                           ] ;
                                            owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                 owl:onProperty [ owl:inverseOf odp:haCollegioNelPeriodo
                                                                                ] ;
                                                                 owl:someValuesFrom odp:OrganoCollegialeElettivo
                                                               ]
                                          ]
                     ] ;
  rdfs:subClassOf odp:AttoDiProclamazione
] .


[ rdf:type owl:Restriction ;
  owl:onProperty [ owl:inverseOf odp:haAttoDiNominaDiOrgano
                 ] ;
  owl:someValuesFrom [ rdf:type owl:Restriction ;
                       owl:onProperty [ owl:inverseOf odp:haTitolareOrganoNelPeriodo
                                      ] ;
                       owl:someValuesFrom odp:OrganoMonocraticoElettivo
                     ] ;
  rdfs:subClassOf odp:AttoDiProclamazione
] .


[ rdf:type owl:Restriction ;
  owl:onProperty [ owl:inverseOf odp:haPeriodoDelCollegio
                 ] ;
  owl:someValuesFrom odp:AssembleaGruppoParlamentareCamera ;
  rdfs:subClassOf odp:LegislaturaCamera
] .


[ rdf:type owl:Restriction ;
  owl:onProperty [ owl:inverseOf odp:haPeriodoDelCollegio
                 ] ;
  owl:someValuesFrom odp:AssembleaGruppoParlamentareSenato ;
  rdfs:subClassOf odp:LegislaturaSenato
] .


[ rdf:type owl:Restriction ;
  owl:onProperty [ owl:inverseOf odp:haPeriodoDelCollegio
                 ] ;
  owl:someValuesFrom odp:CommissioneBicamerale ;
  rdfs:subClassOf odp:Legislatura
] .


[ rdf:type owl:Restriction ;
  owl:onProperty [ owl:inverseOf odp:haPeriodoDelCollegio
                 ] ;
  owl:someValuesFrom odp:CommissionePermanenteCamera ;
  rdfs:subClassOf odp:LegislaturaCamera
] .


[ rdf:type owl:Restriction ;
  owl:onProperty [ owl:inverseOf odp:haPeriodoDelCollegio
                 ] ;
  owl:someValuesFrom odp:CommissionePermanenteSenato ;
  rdfs:subClassOf odp:LegislaturaSenato
] .


[ rdf:type owl:Restriction ;
  owl:onProperty [ owl:inverseOf odp:haPeriodoDelCollegio
                 ] ;
  owl:someValuesFrom odp:CommissioneSpecialeCamera ;
  rdfs:subClassOf odp:LegislaturaCamera
