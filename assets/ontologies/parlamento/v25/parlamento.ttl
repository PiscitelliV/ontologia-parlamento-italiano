odp:testoPropostaDiLegge rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain odp:TestoPropostaLegge ;
                         rdfs:range xsd:string ;
                         rdfs:label "testo proposta di legge"@it .


###  https://w3id.org/italia/Parlamento/titoloDiDocumento
odp:titoloDiDocumento rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf l0:name ;
                      rdf:type owl:FunctionalProperty ;
                      rdfs:domain odp:Documento ;
                      rdfs:range xsd:string ;
                      rdfs:label "titolo di documento"@it .


###  https://w3id.org/italia/Parlamento/titoloProposta
odp:titoloProposta rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain odp:TitoloProposta ;
                   rdfs:range xsd:string ;
                   rdfs:label "titolo proposta"@it .


###  https://w3id.org/italia/Parlamento/titoloPropostaBreve
odp:titoloPropostaBreve rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain odp:TitoloProposta ;
                        rdfs:range xsd:string ;
                        rdfs:label "titolo proposta breve"@it .


###  https://w3id.org/italia/Parlamento/totaleAstenutiVotazione
odp:totaleAstenutiVotazione rdf:type owl:DatatypeProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain odp:VotazioneParlamentare ;
                            rdfs:range xsd:integer ;
                            rdfs:label "totale astenuti votazione"@it .


###  https://w3id.org/italia/Parlamento/totaleContrariVotazione
odp:totaleContrariVotazione rdf:type owl:DatatypeProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain odp:VotazioneParlamentare ;
                            rdfs:range xsd:integer ;
                            rdfs:label "totale contrari votazione"@it .


###  https://w3id.org/italia/Parlamento/totaleFavorevoliVotazione
odp:totaleFavorevoliVotazione rdf:type owl:DatatypeProperty ,
                                       owl:FunctionalProperty ;
                              rdfs:domain odp:VotazioneParlamentare ;
                              rdfs:range xsd:integer ;
                              rdfs:label "totale favorevoli votazione"@it .


###  https://w3id.org/italia/onto/l0identifier
l0:identifier rdf:type owl:DatatypeProperty .


###  https://w3id.org/italia/onto/l0name
l0:name rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class .


###  https://w3id.org/italia/Parlamento/AdesioneGruppo
odp:AdesioneGruppo rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty odp:dataIngressoGruppo ;
                                         owl:someValuesFrom rdfs:Literal
                                       ] ;
                   owl:disjointWith odp:NominaCaricaParlamentare ;
                   rdfs:comment "Appartenenza di un parlamentare (deputato o senatore) a un Gruppo parlamentare (artt. 14 reg.C., 14 reg.S.). Qualora un parlamentare non abbia presentato la dichiarazione di appartenenza a un Gruppo, appartiene al Gruppo Misto. I Senatori di diritto e a vita e i Senatori a vita possono non entrare a far parte di alcun Gruppo. Nel corso della legislatura, sono considerati non iscritti ad alcun Gruppo parlamentare i Senatori che si dimettono dal Gruppo di appartenenza, o ne vengono espulsi."@it ;
                   rdfs:label "Adesione gruppo"@it .


###  https://w3id.org/italia/Parlamento/ArgomentoDiDocumento
odp:ArgomentoDiDocumento rdf:type owl:Class ;
                         rdfs:label "Argomento di documento"@it .


###  https://w3id.org/italia/Parlamento/AssegnazioneACommissione
odp:AssegnazioneACommissione rdf:type owl:Class ;
                             rdfs:comment "Assegnazione di un disegno di legge, da parte del Presidente della Camera (art. 72 reg.C; artt. 34, 35 reg.S.) ovvero del Presidente del Senato (art. 36 reg.S.), a una Commissione parlamentare affinché svolga la sua funzione (referente, deliberante o redigente a seconda delle determinazioni del Presidente stesso ovvero dell’Assemblea). Per l’assegnazione in sede deliberante e in sede redigente alle Commissioni della Camera dei Deputati, è l’Assemblea a decidere (artt. 92 e 96 reg.C.)."@it ;
                             rdfs:label "Assegnazione a commissione"@it .


###  https://w3id.org/italia/Parlamento/AssembleaDelSenato
odp:AssembleaDelSenato rdf:type owl:Class ;
                       owl:disjointWith odp:AssembleaDellaCamera ;
                       rdfs:comment """Organo collegiale del Senato, composto da Senatori eletti per la legislatura in corso, che provvede su:
- nomina Presidente (art 4 reg.S.);
- discussione e delibera sull’approvazione dei progetti di legge (artt. 81, 100, 104, 123, 126 reg.S.);
- mozioni (artt. 157, 161 reg.S.), ad es. di fiducia e sfiducia al Governo; 
- risoluzioni (art. 117 reg.S.) 
- autorizzazioni a procedere (artt. 135 reg.S.)
- commissioni di inchiesta (art. 162 reg.S.)
- questioni regionali."""@it ;
                       rdfs:label "Assemblea del senato"@it .


###  https://w3id.org/italia/Parlamento/AssembleaDellaCamera
odp:AssembleaDellaCamera rdf:type owl:Class ;
                         rdfs:comment """Organo collegiale della Camera composto da Deputati eletti per la legislatura in corso, che provvede su:
- nomina Presidente (artt. 4 reg.C.);
- discussione e delibera sull’approvazione dei progetti di legge (artt. 42, 81. 100, 104, 123, 126, 129 reg.C.);
- mozioni (artt. 110 ss. reg.C.), ad es. di fiducia e sfiducia al Governo; 
- risoluzioni (art. 117 reg.C.) 
- autorizzazioni a procedere (artt. 135 reg.C.)
- commissioni di inchiesta (art. 140 ss. reg.C.)
- questioni regionali."""@it ;
                         rdfs:label "Assemblea della camera"@it .


###  https://w3id.org/italia/Parlamento/AssembleaGruppoParlamentare
odp:AssembleaGruppoParlamentare rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Class ;
                                                      owl:unionOf ( odp:AssembleaGruppoParlamentareCamera
                                                                    odp:AssembleaGruppoParlamentareSenato
                                                                  )
                                                    ] .


###  https://w3id.org/italia/Parlamento/AssembleaGruppoParlamentareCamera
odp:AssembleaGruppoParlamentareCamera rdf:type owl:Class ;
                                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                                            owl:onProperty [ owl:inverseOf odp:haAssembleaGruppoParlamentareCamera
                                                                           ] ;
                                                            owl:someValuesFrom owl:Thing
                                                          ] ;
                                      owl:disjointWith odp:AssembleaGruppoParlamentareSenato ;
                                      rdfs:comment "Organo del gruppo parlamentare della Camera che ne approva il regolamento (“statuto” art. 15 reg.C.) ed è competente, in ogni caso, ad approvare il rendiconto del Gruppo e indicare l'organo responsabile per la gestione amministrativa e contabile del Gruppo. (art. 15-ter reg.C.)"@it ;
                                      rdfs:label "Assemblea gruppo parlamentare camera"@it .


###  https://w3id.org/italia/Parlamento/AssembleaGruppoParlamentareSenato
odp:AssembleaGruppoParlamentareSenato rdf:type owl:Class ;
                                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                                            owl:onProperty [ owl:inverseOf odp:haPresidenteGruppoParlamentareSenato
                                                                           ] ;
                                                            owl:someValuesFrom owl:Thing
                                                          ] ;
                                      rdfs:comment "Organo del gruppo parlamentare del Senato che ne approva il regolamento ed è competente, in ogni caso, ad approvare il rendiconto del Gruppo e indicare l'organo responsabile per la gestione amministrativa e contabile del Gruppo. (art 15 c.3-bis, c.3-ter reg.S.)"@it ;
                                      rdfs:label "Assemblea gruppo parlamentare senato"@it .


###  https://w3id.org/italia/Parlamento/AssembleaParlamentare
odp:AssembleaParlamentare rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:unionOf ( odp:AssembleaDelSenato
                                                              odp:AssembleaDellaCamera
                                                            )
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty odp:haSedutaCollegioParlamentare ;
                                                owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                     owl:onProperty [ owl:inverseOf odp:haEsameInSedutaAssembleaParlamentare
                                                                                    ] ;
                                                                     owl:someValuesFrom owl:Thing
                                                                   ]
                                              ] ;
                          rdfs:comment "Organo collegiale della Camera e del Senato, composto rispettivamente da deputati e senatori eletti per la legislatura in corso, che provvede su:"@it ;
                          rdfs:label "Assemblea parlamentare"@it .


###  https://w3id.org/italia/Parlamento/AttoDiAttivitàCollegiale
odp:AttoDiAttivitàCollegiale rdf:type owl:Class ;
                             rdfs:comment "Documento relativo allo svolgimento di lavori di organi parlamentari collegiali: programma dei lavori, calendario dei lavori, ordine del giorno della seduta, resoconto (stenografico e sommario), riassunto dei lavori, bollettino, processo verbale."@it ;
                             rdfs:label "Atto di attività collegiale"@it .


###  https://w3id.org/italia/Parlamento/AttoDiConvalidaNominaMembro
odp:AttoDiConvalidaNominaMembro rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Restriction ;
                                                      owl:onProperty [ owl:inverseOf odp:haAttoDiConvalidaNominaMembro
                                                                     ] ;
                                                      owl:someValuesFrom owl:Thing
                                                    ] ;
                                rdfs:comment """Alla Camera dei deputati e al Senato è riservata la convalida della elezione dei propri componenti. Pronunciano giudizio definitivo sulle contestazioni, le proteste e, in generale, su tutti i reclami presentati agli Uffici delle singole sezioni elettorali o all'Ufficio centrale durante la loro attività o posteriormente. Nessuna elezione può essere convalidata prima che siano trascorsi venti giorni dalla proclamazione. (Art. 87 DPR 361/1957; art. 27 D.lgs. n. 533/93).
La procedura di convalida coinvolge, alla Camera, la Giunta delle elezioni che formula le proposte di convalida, annullamento o decadenza all’Assemblea (art. 17 Reg.C.), e al Senato, la Giunta delle elezioni e delle immunità, che può adottare deliberazioni di convalida o contestazione delle elezioni (art. 11 Reg. Giunta elez. Sen.)."""@it ;
                                rdfs:label "Atto di convalida nomina membro"@it .


###  https://w3id.org/italia/Parlamento/AttoDiCostituzioneOrgano
odp:AttoDiCostituzioneOrgano rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Restriction ;
                                                   owl:onProperty [ owl:inverseOf odp:haAttoDiCostituzioneOrgano
                                                                  ] ;
                                                   owl:someValuesFrom owl:Thing
                                                 ] ;
                             rdfs:comment "Atto mediante il quale viene costituito un organo collegiale o monocratico della Camera e/o del Senato."@it ;
                             rdfs:label "Atto di costituzione organo parlamentare"@it .


###  https://w3id.org/italia/Parlamento/AttoDiIndirizzoEControlloPolitico
odp:AttoDiIndirizzoEControlloPolitico rdf:type owl:Class ;
                                      rdfs:comment "Atto mediante il quale il Parlamento esercita la funzione di indirizzo e di controllo politico sull’attività del Governo (mozione, risoluzione, ordine del giorno di istruzione, interpellanza e interrogazione)"@it ;
                                      rdfs:label "Atto di indirizzo e controllo politico"@it .


###  https://w3id.org/italia/Parlamento/AttoDiNomina
odp:AttoDiNomina rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty odp:dataAttoDiNomina ;
                                       owl:someValuesFrom rdfs:Literal
                                     ] ;
                 rdfs:comment "Atto attraverso il quale si conferisce ad un soggetto l’esercizio di determinate funzioni. Nell’ambito delle attività parlamentari, ad esempio, vengono nominati i componenti delle giunte, delle commissioni o dei comitati, i relatori."@it ;
                 rdfs:label "Atto di nomina"@it .


###  https://w3id.org/italia/Parlamento/AttoDiProceduraParlamentare
odp:AttoDiProceduraParlamentare rdf:type owl:Class ;
                                rdfs:comment "Atto che instaura una procedura parlamentare o ne conclude una fase. "@it ;
                                rdfs:label "Atto di procedura parlamentare"@it .


###  https://w3id.org/italia/Parlamento/AttoDiProclamazione
odp:AttoDiProclamazione rdf:type owl:Class ;
                        rdfs:subClassOf odp:AttoDiNomina ;
                        rdfs:comment "Atto attraverso il quale i parlamentari entrano nel pieno esercizio delle loro funzioni (art. 1 Reg.S e art. 1 Reg.C.). La proclamazione dei senatori e dei deputati è effettuata, rispettivamente, dall’Ufficio elettorale regionale costituito presso le Corti di appello e dall’Ufficio elettorale centrale nazionale presso la Corte di cassazione. L'Ufficio elettorale regionale proclama eletti i senatori (artt. 16, 17 bis e 21 d. lgs. n. 533/1993); dell'avvenuta proclamazione il presidente dell'ufficio elettorale regionale invia attestato al senatore proclamato e dà immediata notizia alla segreteria del Senato (art. 18 d. lgs. n. 533/1993). L’Ufficio elettorale centrale proclama eletti i deputati (artt. 77 e 84 DPR n. 361/57)."@it ;
                        rdfs:label "Atto di proclamazione"@it .


###  https://w3id.org/italia/Parlamento/AttoParlamentare
odp:AttoParlamentare rdf:type owl:Class ;
                     rdfs:subClassOf odp:DocumentoParlamentare ;
                     rdfs:comment """Atto adottato da un organo parlamentare. Gli atti parlamentari sono di diversa specie e riguardano tutti i procedimenti parlamentari, legislativi, di indirizzo, di controllo, di inchiesta e di natura giurisdizionale.
Viene, altresì, considerato atto parlamentare anche l'atto proveniente da soggetti esterni sottoposti per legge al controllo del Parlamento (es. atto del Governo sottoposto a parere, DOC). Gli atti provenienti da soggetti esterni possono dare o non dare luogo ad una procedura (possono essere solo presentati e pubblicati come atti parlamentari).  """@it ;
                     rdfs:label "Atto parlamentare"@it .


###  https://w3id.org/italia/Parlamento/AutoreDiDocumento
odp:AutoreDiDocumento rdf:type owl:Class ;
                      rdfs:subClassOf [ rdf:type owl:Class ;
                                        owl:unionOf ( l0:Agent
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty [ owl:inverseOf ro:holdsRoleInTime
                                                                       ] ;
                                                        owl:someValuesFrom l0:Agent
                                                      ]
                                                    )
                                      ] ;
                      rdfs:label "Autore di documento"@it .


###  https://w3id.org/italia/Parlamento/Bollettino
odp:Bollettino rdf:type owl:Class ;
               rdfs:comment "Raccolta di resoconti sommari dei lavori delle Giunte e delle Commissioni (Art. 65 Reg. C.) e di altri organi collegiali."@it ;
               rdfs:label "Bollettino"@it .


###  https://w3id.org/italia/Parlamento/CalendarioDeiLavori
odp:CalendarioDeiLavori rdf:type owl:Class ;
                        rdfs:comment "Documento di programmazione approvato dalla Conferenza dei presidenti di Gruppo per delimitare le modalità e i tempi di applicazione del programma dei lavori. (Art. 24 Reg. C.; Art. 55 Reg. S.)."@it ;
                        rdfs:label "Calendario dei lavori"@it .


###  https://w3id.org/italia/Parlamento/Camera
odp:Camera rdf:type owl:Class ;
           owl:disjointWith odp:Senato ;
           rdfs:comment "Organo collegiale del Parlamento cui spetta, collettivamente e alla pari con il Senato, l’esercizio del potere legislativo (art. 70 Cost.). La Camera dei deputati è eletta a suffragio universale e diretto. Il numero dei deputati è di quattrocento, otto dei quali eletti nella circoscrizione Estero (art. 56 Cost.)."@it ;
           rdfs:label "Camera"@it .


###  https://w3id.org/italia/Parlamento/CategoriaDocumentoParlamentare
odp:CategoriaDocumentoParlamentare rdf:type owl:Class ;
                                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                                         owl:onProperty odp:dataInizioValiditàCategoria ;
                                                         owl:someValuesFrom rdfs:Literal
                                                       ] ;
                                   rdfs:label "Categoria documento parlamentare"@it .


###  https://w3id.org/italia/Parlamento/CodificaPropostaDilegge
odp:CodificaPropostaDilegge rdf:type owl:Class ;
                            rdfs:label "Codifica proposta di legge"@it .


###  https://w3id.org/italia/Parlamento/CollegioNelPeriodo
odp:CollegioNelPeriodo rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty odp:haPeriodoDelCollegio ;
                                             owl:someValuesFrom owl:Thing
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty [ owl:inverseOf odp:haCollegioNelPeriodo
                                                            ] ;
                                             owl:someValuesFrom owl:Thing
                                           ] ;
                       owl:disjointWith odp:TitolareOrganoMonocratico ;
                       rdfs:label "Collegio nel periodo"@it .


###  https://w3id.org/italia/Parlamento/CollegioParlamentare
odp:CollegioParlamentare rdf:type owl:Class ;
                         rdfs:subClassOf odp:CollegioNelPeriodo ;
                         rdfs:comment "Organo collegiale del Parlamento."@it ;
                         rdfs:label "Collegio parlamentare"@it .


###  https://w3id.org/italia/Parlamento/CommissioneBicamerale
odp:CommissioneBicamerale rdf:type owl:Class ;
                          rdfs:comment "Organo parlamentare bicamerale collegiale composto, in numero uguale, da deputati e senatori. Possono essere permanenti (es. Commissione sulle questioni regionali, v.), sia straordinarie (es. C. di controllo sui servizi radiotelevisivi, legge n. 103/1975; C. di servizi informativi e sicurezza, legge n. 124/2007). Possono riguardare inchieste parlamentari deliberate da entrambe le Camere (C. bicamerali d’inchiesta)."@it ;
                          rdfs:label "Commissione bicamerale"@it .


###  https://w3id.org/italia/Parlamento/CommissioneInchiesta
odp:CommissioneInchiesta rdf:type owl:Class ;
                         rdfs:subClassOf odp:CommissioneSpeciale ;
                         rdfs:comment """Organo parlamentare collegiale costituito allorquando la Camera (artt. 140 reg.C., 162 reg.S.) decide di procedere a un’inchiesta parlamentare su questioni di pubblico interesse approvata secondo la procedura prevista per i progetti di legge (art. 82 Cost.). La Commissione d'inchiesta procede alle indagini e agli esami con gli stessi poteri e le stesse limitazioni dell'autorità giudiziaria.
Se entrambe le Camere deliberano un'inchiesta sull'identica materia, le Commissioni delle due Camere possono deliberare di procedere congiuntamente (v. C. bicamerale)."""@it ;
                         rdfs:label "Commissione inchiesta"@it .


###  https://w3id.org/italia/Parlamento/CommissioneParlamentare
odp:CommissioneParlamentare rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                  owl:onProperty odp:haSedutaCollegioParlamentare ;
                                                  owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                       owl:onProperty [ owl:inverseOf odp:haEsameInSedutaCommissioneParlamentare
                                                                                      ] ;
                                                                       owl:someValuesFrom owl:Thing
                                                                     ]
                                                ] ;
                            rdfs:comment """Organo collegiale della Camera o del Senato, composto rispettivamente da deputati e da senatori in modo da rispecchiare la proporzione dei gruppi parlamentari (artt. 72, c. 3, 82, c. 2, Cost.; art. 21 reg.S.), al quale il Presidente della relativa camera parlamentare assegna progetti di legge, questioni/affari e funzioni in tema di indirizzo, controllo e informazione (artt. 22 reg.C., 34 reg.S.).
Le commissioni parlamentari sono: 
-speciali o straordinarie (costituite per temi specifici);
-permanenti (14 alla Camera, art. 22 reg.C; 10 al Senato, art. 22 reg.S).
Le commissioni sono funzionalmente classificabili in c. in sede referente (art. 72, c.1, Cost), c. in sede deliberante o legislativa (art. 72, c.3, Cost), c. in sede consultiva, c. in sede redigente."""@it ;
                            rdfs:label "Commissione parlamentare"@it .


###  https://w3id.org/italia/Parlamento/CommissionePermanente
odp:CommissionePermanente rdf:type owl:Class ;
                          rdfs:comment """Organo sia della Camera (art. 20 reg.C.), sia del Senato (artt. 21 e 22 reg.S.) competente sulle materie indicate per ciascuna commissione e rinnovato ogni due anni con possibilità di riconferma dei componenti.
Le Commissioni si riuniscono in sede referente per l'esame delle questioni sulle quali devono riferire all’Assemblea; in sede consultiva per esprimere pareri; in sede legislativa o deliberante per l'esame e l'approvazione dei progetti di legge; in sede redigente. 
Organo delle Commissioni permanenti è l’ufficio di presidenza composto da presidente, due vicepresidenti e due segretari (artt. 2° reg.C., 27 reg.S.).
Commissioni permanenti della Camera (art. 22 reg.C.): 
I - Affari costituzionali, della Presidenza del Consiglio e interni; 
II - Giustizia;
III - Affari esteri e comunitari;
IV - Difesa;
V - Bilancio, tesoro e programmazione;
VI - Finanze;
VII - Cultura, scienza e istruzione;
VIII - Ambiente, territorio e lavori pubblici;
IX - Trasporti, poste e telecomunicazioni;
X - Attività produttive, commercio e turismo;
XI - Lavoro pubblico e privato;
XII - Affari sociali;
XIII – Agricoltura:
XIV - Politiche dell'Unione europea
Commissioni permanenti del Senato (art. 22 reg.S.): 
1ª Affari costituzionali, affari della Presidenza del Consiglio e dell'Interno, ordinamento generale dello Stato e della Pubblica Amministrazione, editoria, digitalizzazione
  2ª Giustizia
  3ª Affari esteri e difesa
  4ª Politiche dell'Unione europea
  5ª Programmazione economica, bilancio
  6ª Finanze e tesoro
  7ª Cultura e patrimonio culturale, istruzione pubblica, ricerca scientifica, spettacolo e sport
  8ª Ambiente, transizione ecologica, energia, lavori pubblici, comunicazioni, innovazione tecnologica
  9ª Industria, commercio, turismo, agricoltura e produzione agroalimentare
  10ª Affari sociali, sanità, lavoro pubblico e privato, previdenza sociale"""@it ;
                          rdfs:label "Commissione permanente"@it .


###  https://w3id.org/italia/Parlamento/CommissionePermanenteCamera
odp:CommissionePermanenteCamera rdf:type owl:Class ;
                                owl:disjointWith odp:CommissionePermanenteSenato ;
                                rdfs:comment """Organo della Camera (art. 20 reg.C.), competente sulle materie indicate per ciascuna commissione e rinnovato ogni due anni con possibilità di riconferma dei componenti.
Commissioni permanenti della Camera sono (art. 22 reg.C.): 
I - Affari costituzionali, della Presidenza del Consiglio e interni; 
II - Giustizia;
III - Affari esteri e comunitari;
IV - Difesa;
V - Bilancio, tesoro e programmazione;
VI - Finanze;
VII - Cultura, scienza e istruzione;
VIII - Ambiente, territorio e lavori pubblici;
IX - Trasporti, poste e telecomunicazioni;
X - Attività produttive, commercio e turismo;
XI - Lavoro pubblico e privato;
XII - Affari sociali;
XIII – Agricoltura:
XIV - Politiche dell'Unione europea"""@it ;
                                rdfs:label "Commissione permanente camera"@it .


###  https://w3id.org/italia/Parlamento/CommissionePermanenteSenato
odp:CommissionePermanenteSenato rdf:type owl:Class ;
                                rdfs:comment """Organo del Senato (artt. 21 e 22 reg.S.) competente sulle materie indicate per ciascuna commissione. Esse vengono rinnovate dopo il primo biennio della legislatura ed i loro componenti possono essere confermati.
Le Commissioni permanenti del Senato sono (art. 22 reg.S.): 
-	1ª Affari costituzionali, affari della Presidenza del Consiglio e dell'Interno, ordinamento generale dello Stato e della Pubblica Amministrazione, editoria, digitalizzazione;
-	2ª Giustizia;
-	3ª Affari esteri e difesa;
-	4ª Politiche dell'Unione europea;
-	5ª Programmazione economica, bilancio;
-	6ª Finanze e tesoro;
-	7ª Cultura e patrimonio culturale, istruzione pubblica, ricerca scientifica, spettacolo e sport;
-	8ª Ambiente, transizione ecologica, energia, lavori pubblici, comunicazioni, innovazione tecnologica;
-	9ª Industria, commercio, turismo, agricoltura e produzione agroalimentare;
-	10ª Affari sociali, sanità, lavoro pubblico e privato, previdenza sociale"""@it ;
                                rdfs:label "Commissione permanente senato"@it .


###  https://w3id.org/italia/Parlamento/CommissioneSpeciale
odp:CommissioneSpeciale rdf:type owl:Class ;
                        rdfs:comment "Commissione parlamentare costituita, in aggiunta alle commissioni permanenti, dall’assemblea del Senato o della Camera per specifiche materie e composta nel rispetto della proporzione dei gruppi parlamentari. (art. 22 reg.C., 24 reg.S.)"@it ;
                        rdfs:label "Commissione speciale"@it .


###  https://w3id.org/italia/Parlamento/CommissioneSpecialeCamera
odp:CommissioneSpecialeCamera rdf:type owl:Class ;
                              owl:disjointWith odp:CommissioneSpecialeSenato ;
                              rdfs:comment "Commissione parlamentare costituita, in aggiunta alle commissioni permanenti, dall’assemblea della Camera per specifiche materie e composta nel rispetto della proporzione dei gruppi parlamentari. (art. 22 reg.C.)"@it ;
                              rdfs:label "Commissione speciale camera"@it .


###  https://w3id.org/italia/Parlamento/CommissioneSpecialeSenato
odp:CommissioneSpecialeSenato rdf:type owl:Class ;
                              rdfs:comment "Commissione parlamentare costituita, in aggiunta alle commissioni permanenti, dall’assemblea del Senato per specifiche materie e composta nel rispetto della proporzione dei gruppi parlamentari. (art. 24 reg.S.)"@it ;
                              rdfs:label "Commissione speciale senato"@it .


###  https://w3id.org/italia/Parlamento/ComponentePoliticaGMCamera
odp:ComponentePoliticaGMCamera rdf:type owl:Class ;
                               rdfs:comment "Formazione all’interno del gruppo misto di almeno dieci deputati non appartenenti ad altro gruppo. Possono essere altresì formate componenti di consistenza inferiore, purché vi aderiscano deputati, in numero non minore di tre, i quali rappresentino un partito o movimento politico la cui esistenza, alla data di svolgimento delle elezioni per la Camera dei deputati, risulti in forza di elementi certi e inequivoci, e che abbia presentato, anche congiuntamente con altri, liste di candidati ovvero candidature nei collegi uninominali. Un’unica componente politica all’interno del Gruppo misto può essere altresì costituita da deputati, in numero non inferiore a tre, appartenenti a minoranze linguistiche tutelate dalla Costituzione e individuate dalla legge, i quali siano stati eletti, sulla base o in collegamento con liste che di esse siano espressione, nelle zone in cui tali minoranze sono tutelate (Art. 14, c. 5, Reg. C.)."@it ;
                               rdfs:label "Componente politica gm camera"@it .


###  https://w3id.org/italia/Parlamento/ComponentePoliticaGMSenato
odp:ComponentePoliticaGMSenato rdf:type owl:Class ;
                               rdfs:comment "Formazione all’interno del gruppo misto rappresentante un partito o movimento politico, anche risultante all’aggregazione di più partiti o movimenti politici, che abbia presentato alle ultime elezioni del Senato propri candidati con lo stesso contrassegno, conseguendo l’elezione di almeno un Senatore. È altresì consentita la costituzione di componenti politiche in seno al Gruppo misto, che rappresentino un partito o un movimento politico che nella legislatura abbia presentato alle elezioni politiche, regionali o del Parlamento europeo propri candidati conseguendo l’elezione di propri rappresentanti (Art. 14, c. 6, Reg. S.)."@it ;
                               rdfs:label "Componente politica gm senato"@it .


###  https://w3id.org/italia/Parlamento/ConclusoEsameCommissione
odp:ConclusoEsameCommissione rdf:type owl:Class ;
                             rdfs:comment "Conclusione della discussione della proposta di legge in commissione in sede referente, redigente, legislativa-deliberante e consultiva."@it ;
                             rdfs:label "Concluso esame commissione"@it .


###  https://w3id.org/italia/Parlamento/ContenutoDiDocumento
odp:ContenutoDiDocumento rdf:type owl:Class ;
                         rdfs:label "Contenuto di documento"@it .


###  https://w3id.org/italia/Parlamento/Deputato
odp:Deputato rdf:type owl:Class ;
             owl:disjointWith odp:Senatore ;
             rdfs:comment "Parlamentare membro della Camera dei deputati votato con elezione a suffragio universale e diretto il cui mandato coincide con la durata della legislatura rispetto alla quale viene eletto."@it ;
             rdfs:label "Deputato"@it .


###  https://w3id.org/italia/Parlamento/DirettivaUE
odp:DirettivaUE rdf:type owl:Class ;
                rdfs:subClassOf odp:DocumentoExtraParlamentare ;
                rdfs:label "Direttiva UE"@it .


###  https://w3id.org/italia/Parlamento/Documento
odp:Documento rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty odp:haAutoreDiDocumento ;
                                    owl:someValuesFrom owl:Thing
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty odp:codiceDiDocumento ;
                                    owl:someValuesFrom rdfs:Literal
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty odp:dataDiDocumento ;
                                    owl:someValuesFrom rdfs:Literal
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty odp:titoloDiDocumento ;
                                    owl:someValuesFrom rdfs:Literal
                                  ] ;
              rdfs:comment "Documento elettronico o analogico che contiene la rappresentazione informatica e non informatica di atti, fatti o dati giuridicamente rilevanti."@it ;
              rdfs:label "Documento"@it .


###  https://w3id.org/italia/Parlamento/DocumentoExtraParlamentare
odp:DocumentoExtraParlamentare rdf:type owl:Class ;
                               owl:disjointWith odp:DocumentoParlamentare ;
                               rdfs:comment "Documento adottato al di fuori dell’attività parlamentare, prodotto da enti o autorità istituzionali, come Agenzie, Ministeri o altre Pubbliche Amministrazioni o enti. "@it ;
                               rdfs:label "Documento extra parlamentare"@it .


###  https://w3id.org/italia/Parlamento/DocumentoParlamentare
odp:DocumentoParlamentare rdf:type owl:Class ;
                          rdfs:comment "Documento adottato nell’ambito dell’attività parlamentare. I documenti parlamentari sono di diversa specie e riguardano tutti i procedimenti parlamentari, legislativi, di indirizzo, di controllo, di inchiesta e di natura giurisdizionale. I documenti includono gli atti parlamentari e i dossier parlamentari."@it ;
                          rdfs:label "Documento parlamentare"@it .


###  https://w3id.org/italia/Parlamento/ElezioneDelParlamento
odp:ElezioneDelParlamento rdf:type owl:Class ;
                          rdfs:comment "Designazione, da parte di votanti (elettori), delle persone (eletti) alle quali viene, così, affidato l’incarico di rappresentanza politica in Parlamento (mandato parlamentare)."@it ;
                          rdfs:label "Elezione del parlamento"@it .


###  https://w3id.org/italia/Parlamento/Emendamento
odp:Emendamento rdf:type owl:Class ;
                rdfs:comment "Proposta presentata da singoli parlamentari, dalla Commissione o dal Governo aventi la finalità di modificare una proposta di legge in discussione in Commissione o in Assemblea (Art. 85 – 88 Reg. C.; Art. 100 Reg. S.). Gli emendamenti sono di regola stampati e distribuiti in principio di seduta (Art. 100, c. 13, Reg. S.)."@it ;
                rdfs:label "Emendamento"@it .


###  https://w3id.org/italia/Parlamento/EsameDelPresidenteDellaRepubblica
odp:EsameDelPresidenteDellaRepubblica rdf:type owl:Class ;
                                      rdfs:comment "Esame del testo della proposta di legge, approvato dalle Camere, da parte del Presidente della Repubblica ai fini della sua promulgazione (Art. 73 Cost.) o del suo rinvio al Parlamento (Art. 74 Cost.)"@it ;
                                      rdfs:label "Esame del presidente della repubblica"@it .


###  https://w3id.org/italia/Parlamento/EsameInAssemblea
odp:EsameInAssemblea rdf:type owl:Class ;
                     rdfs:comment "Esame da parte dell’Assemblea parlamentare del testo della proposta di legge, approvata integralmente dalla Commissione (in sede referente o redigente). L’esame in Assemblea dei progetti di legge comprende la discussione sulle linee generali del progetto e la discussione degli articoli (Art. 82 Reg. C.)."@it ;
                     rdfs:label "Esame in assemblea"@it .


###  https://w3id.org/italia/Parlamento/EsameInCommissione
odp:EsameInCommissione rdf:type owl:Class ;
                       rdfs:comment "Esame della proposta di legge da parte delle Commissioni competenti in sede referente, redigente, legislativa-deliberante e consultiva."@it ;
                       rdfs:label "Esame in commissione"@it .


###  https://w3id.org/italia/Parlamento/Firmatario
odp:Firmatario rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty [ owl:inverseOf odp:haFirmatario
                                                    ] ;
                                     owl:someValuesFrom owl:Thing
                                   ] ;
               rdfs:comment "Soggetto che presenta una proposta di legge al Parlamento (si distingue il primo firmatario dai cofirmatari) o un emendamento alla stessa o un atto di sindacato ispettivo. La presentazione di un progetto di legge a una delle due Camere spetta al Governo, a ciascun parlamentare, a 50.000 elettori e agli organi e enti ai quali la legge conferisce il potere di iniziativa legislativa. (art. 71 Cost.)	 50.000 elettori e ad organi e enti ai quali la legge conferisce il potere di iniziativa legislativa. (art. 71 Cost.)	"@it ;
               rdfs:label "Firmatario"@it .


###  https://w3id.org/italia/Parlamento/FunzioneParlamentare
odp:FunzioneParlamentare rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty odp:dataInizioFunzioneParlamentare ;
                                               owl:someValuesFrom rdfs:Literal
                                             ] ;
                         owl:disjointWith odp:Organo ,
                                          odp:PresidenteDiCollegioParlamentare ;
                         rdfs:comment "Insieme dei compiti, poteri e doveri attribuiti a un parlamentare."@it ;
                         rdfs:label "Funzione parlamentare"@it .


###  https://w3id.org/italia/Parlamento/GiuntaParlamentare
odp:GiuntaParlamentare rdf:type owl:Class ;
                       rdfs:comment "Organo collegiale investito di compiti e funzioni tecniche legati al corretto funzionamento delle Camere e all'autonomia del Parlamento rispetto agli altri poteri. I componenti di ciascuna Giunta sono direttamente nominati dai rispettivi Presidenti di Camera e Senato, tenendo conto dell'esigenza che i Gruppi vi siano adeguatamente rappresentati."@it ;
                       rdfs:label "Giunta parlamentare"@it .


###  https://w3id.org/italia/Parlamento/GruppoMistoCamera
odp:GruppoMistoCamera rdf:type owl:Class ;
                      rdfs:subClassOf odp:GruppoParlamentareCamera ;
                      rdfs:comment "Gruppo parlamentare composto dai deputati che non abbiano dichiarato di appartenere ad altro Gruppo o non appartengano ad alcun Gruppo. (art. 14, c.4 reg.C.)."@it ;
                      rdfs:label "Gruppo misto camera"@it .


###  https://w3id.org/italia/Parlamento/GruppoMistoSenato
odp:GruppoMistoSenato rdf:type owl:Class ;
                      rdfs:subClassOf odp:GruppoParlamentareSenato ;
                      rdfs:comment "Gruppo parlamentare composto dai senatori - ad eccezione dei senatori a vita e di diritto che possono non appartenere ad alcun Gruppo - che non abbiano dichiarato di appartenere ad altro Gruppo o non appartengano ad alcun Gruppo. (art. 14 reg.S.)."@it ;
                      rdfs:label "Gruppo misto senato"@it .


###  https://w3id.org/italia/Parlamento/GruppoParlamentare
odp:GruppoParlamentare rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty odp:codiceGruppo ;
                                             owl:someValuesFrom rdfs:Literal
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty odp:dataCostituzioneGruppo ;
                                             owl:someValuesFrom rdfs:Literal
                                           ] ;
                       rdfs:comment """Associazione di deputati (art. 14 reg. C.) o di senatori (art. 14 reg. S.) necessaria per il funzionamento delle rispettive Camere di appartenenza: formazione delle commissioni parlamentari (art. 72 Cost.); programma dei lavori dell’Assemblea e delle Commissioni (artt. 13, 23 reg. C.; art. 53 reg.S.); la discussione in Assemblea e nelle Commissioni (art. 44 reg. C.); la presentazione di una mozione all’Assemblea (art. 110 reg. C.). Il gruppo può richiedere, tramite il proprio presidente, la votazione nominale ovvero lo scrutinio segreto (art. 51 reg.C.; 113 reg.S.)
Ogni parlamentare, ad eccezione dei senatori di diritto e a vita, deve iscriversi a un gruppo; in mancanza di adesione a un gruppo, il parlamentare viene iscritto nel gruppo misto.
Alla Camera, sono organi del gruppo: presidente, vicepresidenti, comitato direttivo e assemblea (art. 15 reg.C.)  .
Al Senato, sono organi del gruppo: presidente, assemblea, vicepresidenti, segretari, tesoriere (art. 15 reg.S.)."""@it ;
                       rdfs:label "Gruppo parlamentare"@it .


###  https://w3id.org/italia/Parlamento/GruppoParlamentareCamera
odp:GruppoParlamentareCamera rdf:type owl:Class ;
                             owl:disjointWith odp:GruppoParlamentareSenato ;
                             rdfs:comment """Associazione di deputati (art. 14 reg. C.) necessaria per il funzionamento della Camera. Esso svolge un ruolo attivo nelle seguenti funzioni: formazione delle commissioni parlamentari (art. 72 Cost.); programma dei lavori dell’Assemblea e delle Commissioni (artt. 13, 23 reg. C.); la discussione in Assemblea e nelle Commissioni (art. 44 reg. C.); la presentazione di una mozione all’Assemblea (art. 110 reg. C.). Il gruppo può richiedere, tramite il proprio presidente, la votazione nominale ovvero lo scrutinio segreto (art. 51 reg.C.)
Ogni parlamentare deve iscriversi a un gruppo; in mancanza di adesione a un gruppo, il parlamentare viene iscritto nel gruppo misto.
Alla Camera, sono organi del gruppo: presidente, assemblea, vicepresidenti e comitato direttivo (art. 15 reg.C.)."""@it ;
                             rdfs:label "Gruppo parlamentare camera"@it .


###  https://w3id.org/italia/Parlamento/GruppoParlamentareSenato
odp:GruppoParlamentareSenato rdf:type owl:Class ;
                             rdfs:comment """Associazione di senatori (art. 14 reg. S.) necessaria per il funzionamento del Senato. Esso svolge un ruolo attivo nelle seguenti funzioni: formazione delle commissioni parlamentari (art. 72 Cost.); programma dei lavori dell’Assemblea e delle Commissioni (Art. 53 reg.S.); Il gruppo può richiedere, tramite il proprio presidente, la votazione nominale ovvero lo scrutinio segreto (art. 51 reg.C.; 113 reg.S.).
Ogni senatore, ad eccezione dei senatori di diritto e a vita, deve iscriversi a un gruppo; in mancanza di adesione a un gruppo, il parlamentare viene iscritto nel gruppo misto.
Al Senato, sono organi del gruppo: presidente, assemblea, vicepresidenti, segretari, tesoriere (art. 15 reg.S.)."""@it ;
                             rdfs:label "Gruppo parlamentare senato"@it .


###  https://w3id.org/italia/Parlamento/Interpellanza
odp:Interpellanza rdf:type owl:Class ;
                  rdfs:comment "Domanda rivolta al Governo circa i motivi o gli intendimenti della sua condotta su questioni di particolare rilievo o di carattere generale (Art. 154 Reg. S.; Art. 136 Reg. C.)"@it ;
                  rdfs:label "Interpellanza"@it .


###  https://w3id.org/italia/Parlamento/Interrogazione
odp:Interrogazione rdf:type owl:Class ;
                   rdfs:comment "Domanda rivolta al Ministro competente per avere informazioni o spiegazioni su un oggetto determinato o per sapere se e quali provvedimenti siano stati adottati o si intendano adottare in relazione all’oggetto medesimo (Art. 145, c. 1 Reg. S.; Art. 128 Reg. C.). Un Senatore che intenda rivolgere una interrogazione deve presentarla per iscritto, indicando se chiede risposta scritta o risposta orale. (Art. 145, c. 3, Reg. S). Esse sono pubblicate nel resoconto della seduta in cui sono annunziate (Art. 129 Reg. C)."@it ;
                   rdfs:label "Interrogazione"@it .


###  https://w3id.org/italia/Parlamento/InterventoSuPropostaDiLegge
odp:InterventoSuPropostaDiLegge rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Restriction ;
                                                      owl:onProperty odp:interventoFattoDa ;
                                                      owl:someValuesFrom owl:Thing
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty odp:dataInterventoSuPropostaDiLegge ;
                                                      owl:someValuesFrom rdfs:Literal
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty odp:testoInterventoSuPropostaDiLegge ;
                                                      owl:someValuesFrom rdfs:Literal
                                                    ] ;
                                rdfs:label "Intervento su proposta di legge"@it .


###  https://w3id.org/italia/Parlamento/Legge
odp:Legge rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty odp:èPromulgataDa ;
                                owl:someValuesFrom owl:Thing
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty [ owl:inverseOf odp:promulgazioneLegge
                                               ] ;
                                owl:someValuesFrom owl:Thing
                              ] ;
          rdfs:comment "Atto normativo contenente un enunciato generale e astratto. La legge ordinaria è approvata dal Parlamento e non può né modificare la Costituzione o altra legge di rango costituzionale, né contenere disposizioni in qualsiasi modo in contrasto con norme costituzionali (Art.134 Cost.)."@it ;
          rdfs:label "Legge"@it .


###  https://w3id.org/italia/Parlamento/LeggePubblicataInGazzettaUfficiale
odp:LeggePubblicataInGazzettaUfficiale rdf:type owl:Class ;
                                       rdfs:comment "Legge pubblicata in Gazzetta Ufficiale al fine della sua entrata in vigore. Le leggi sono pubblicate subito dopo la promulgazione ed entrano in vigore il quindicesimo giorno successivo alla loro pubblicazione, salvo che le leggi stesse stabiliscano un termine diverso (Art. 73, c. 3 Cost.) "@it ;
                                       rdfs:label "Legge pubblicata in gazzetta ufficiale"@it .


###  https://w3id.org/italia/Parlamento/Legislatura
odp:Legislatura rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty odp:numeroLegislatura ;
                                      owl:someValuesFrom rdfs:Literal
                                    ] ;
                rdfs:subClassOf TI:TemporalEntity ;
                rdfs:comment "Ciclo di attività legislativa di Camera e Senato. La legislatura dura 5 anni, salvo proroga con legge in caso di guerra (art. 60 Cost.) o scioglimento anticipato da parte del Presidente della Repubblica (art. 88 Cost.), e ha inizio con la prima riunione delle nuove Camere che ha luogo non oltre il ventesimo giorno dalle elezioni; finché non siano riunite le nuove Camere, sono prorogati i poteri delle precedenti (art. 61 Cost.). "@it ;
                rdfs:label "Legislatura"@it .


###  https://w3id.org/italia/Parlamento/LegislaturaCamera
odp:LegislaturaCamera rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty [ owl:inverseOf odp:haPeriodoDelCollegio
                                                           ] ;
                                            owl:someValuesFrom odp:AssembleaDellaCamera
                                          ] ;
                      owl:disjointWith odp:LegislaturaSenato ;
                      rdfs:comment "Ciclo di attività legislativa della camera. La legislatura dura 5 anni, salvo proroga con legge in caso di guerra (art. 60 Cost.) o scioglimento anticipato da parte del Presidente della Repubblica (art. 88 Cost.), e ha inizio con la prima riunione delle nuove Camere che ha luogo non oltre il ventesimo giorno dalle elezioni; finché non siano riunite le nuove Camere, sono prorogati i poteri delle precedenti (art. 61 Cost.)."@it ;
                      rdfs:label "Legislatura camera"@it .


###  https://w3id.org/italia/Parlamento/LegislaturaSenato
odp:LegislaturaSenato rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty [ owl:inverseOf odp:haPeriodoDelCollegio
                                                           ] ;
                                            owl:someValuesFrom odp:AssembleaDelSenato
                                          ] ;
                      rdfs:comment "Ciclo di attività legislativa del Senato. La legislatura dura 5 anni, salvo proroga con legge in caso di guerra (art. 60 Cost.) o scioglimento anticipato da parte del Presidente della repubblica (art. 88 Cost.), e ha inizio con la prima riunione delle nuove Camere che ha luogo non oltre il ventesimo giorno dalle elezioni; finché non siano riunite le nuove Camere, sono prorogati i poteri delle precedenti (art. 61 Cost.)."@it ;
                      rdfs:label "Legislatura senato"@it .


###  https://w3id.org/italia/Parlamento/LetturaPropostaDiLegge
odp:LetturaPropostaDiLegge rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty odp:dataFineLettura ;
                                                 owl:someValuesFrom rdfs:Literal
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty odp:dataInizioLettura ;
                                                 owl:someValuesFrom rdfs:Literal
                                               ] ;
                           rdfs:comment "Esame della proposta di legge da parte di una delle due Camere parlamentari."@it ;
                           rdfs:label "Lettura proposta di legge"@it .


###  https://w3id.org/italia/Parlamento/Mandato
odp:Mandato rdf:type owl:Class ;
            rdfs:subClassOf odp:NominaDiMembroDelCollegio ;
            rdfs:comment "Incarico di rappresentanza politica in Parlamento conferito dagli elettori ai parlamentari (senatori e deputati); ogni membro del Parlamento rappresenta la Nazione ed esercita le sue funzioni senza vincolo di mandato (art. 67 Cost.)."@it ;
            rdfs:label "Mandato"@it .


###  https://w3id.org/italia/Parlamento/MembroDelCollegio
odp:MembroDelCollegio rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty odp:èMembroDelCollegio ;
                                            owl:someValuesFrom owl:Thing
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty [ owl:inverseOf odp:haMembroDelCollegio
                                                           ] ;
                                            owl:someValuesFrom owl:Thing
                                          ] ;
                      rdfs:comment "Componente di un organo collegiale a seguito di nomina o elezione."@it ;
                      rdfs:label "Membro del collegio"@it .


###  https://w3id.org/italia/Parlamento/MembroDelGoverno
odp:MembroDelGoverno rdf:type owl:Class ;
                     rdfs:subClassOf odp:MembroDelCollegio ;
                     rdfs:comment """Componente dell’organo esecutivo dello Stato. Il Governo della Repubblica è composto del Presidente del Consiglio e dei Ministri, che costituiscono insieme il Consiglio dei Ministri (Art. 92 Cost.).
Il Presidente del Consiglio dei ministri dirige la politica generale del Governo e ne è responsabile. Mantiene l’unità di indirizzo politico ed amministrativo, promuovendo e coordinando l’attività dei ministri. I ministri sono responsabili collegialmente degli atti del Consiglio dei ministri, e individualmente degli atti dei loro dicasteri (Art. 95 Cost.).
Il Governo può esercitare l’iniziativa legislativa (art. 71 Cost.)."""@it ;
                     rdfs:label "Membro del governo"@it .


###  https://w3id.org/italia/Parlamento/Mozione
odp:Mozione rdf:type owl:Class ;
            rdfs:comment "Richiesta finalizzata a promuovere una deliberazione del Parlamento su un determinato argomento e presentata da almeno cinque Senatori o sette deputati (Art. 110 Reg. C; Art. 157 Reg. S.). Particolare rilievo ha la mozione di fiducia o sfiducia al Governo (Art. 94 Cost.)."@it ;
            rdfs:label "Mozione"@it .


###  https://w3id.org/italia/Parlamento/NaturaPropostaDiLegge
odp:NaturaPropostaDiLegge rdf:type owl:Class ;
                          rdfs:subClassOf skos:Concept ;
                          rdfs:comment "Elemento che specifica l'oggetto e/o l'iter di approvazione di una proposta di legge (ordinaria, costituzionale, approvazione bilancio, conversione decreto legge). "@it ;
                          rdfs:label "Natura proposta di legge"@it .


###  https://w3id.org/italia/Parlamento/NomeGruppoParlamentare
odp:NomeGruppoParlamentare rdf:type owl:Class ;
                           rdfs:label "Nome gruppo parlamentare"@it .


###  https://w3id.org/italia/Parlamento/NominaCaricaParlamentare
odp:NominaCaricaParlamentare rdf:type owl:Class ;
                             rdfs:subClassOf [ rdf:type owl:Class ;
                                               owl:unionOf ( odp:NominaDiMembroDelCollegio
                                                             odp:TitolareOrganoMonocratico
                                                           )
                                             ] ;
                             rdfs:label "Nomina carica parlamentare"@it .


###  https://w3id.org/italia/Parlamento/NominaDiMembroDelCollegio
odp:NominaDiMembroDelCollegio rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Restriction ;
                                                    owl:onProperty odp:haAttoDiNominaDiMembroDelCollegio ;
                                                    owl:someValuesFrom owl:Thing
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty odp:dataNominaMembroDelCollegio ;
                                                    owl:someValuesFrom rdfs:Literal
                                                  ] ;
                              owl:disjointWith odp:TitolareOrganoMonocratico ;
                              rdfs:label "Nomina di membro del collegio"@it .


###  https://w3id.org/italia/Parlamento/OggettoVotazioneParlamentare
odp:OggettoVotazioneParlamentare rdf:type owl:Class ;
                                 rdfs:label "Oggetto votazione parlamentare"@it .


###  https://w3id.org/italia/Parlamento/OrdineDelGiornoDellaSeduta
odp:OrdineDelGiornoDellaSeduta rdf:type owl:Class ;
                               rdfs:subClassOf l0:Collection ;
                               rdfs:comment "Elenco degli argomenti da discutere e trattare in una seduta di un organo collegiale al fine di una discussione strutturata e secondo una sequenza prestabilita."@it ;
                               rdfs:label "Ordine del giorno della seduta"@it .


###  https://w3id.org/italia/Parlamento/OrdineDelGiornoDiIstruzioneAlGoverno
odp:OrdineDelGiornoDiIstruzioneAlGoverno rdf:type owl:Class ;
                                         rdfs:comment "Atto di indirizzo dell’assemblea della Camera o del Senato riguardo a specifiche indicazioni da rivolgere al Governo sulla materia trattata nel disegno di legge (Art. 88 Reg. C., Art. 95 Reg. S.); il rappresentante del Governo è chiamato a pronunciarsi sugli ordini del giorno di istruzione al Governo avendo a disposizione tre opzioni: può esprimere parere favorevole, parere contrario oppure accoglierli come raccomandazione. Gli ordini del giorno possono essere presentati: al Senato, in Assemblea e in Commissione in sede deliberante e redigente (artt. 41, c.4; 42 Reg. S.); alla Camera, soltanto in Assemblea e vengono votati dopo l’approvazione dell’ultimo articolo ma prima della votazione finale del progetto di legge."@it ;
                                         rdfs:label "Ordine del giorno di istruzione al governo"@it .


###  https://w3id.org/italia/Parlamento/Organo
odp:Organo rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Class ;
                                 owl:unionOf ( odp:OrganoCollegiale
                                               odp:OrganoMonocratico
                                             )
                               ] ;
           rdfs:comment "Ufficio previsto da una norma dell’ordinamento giuridico come idoneo ad esprimere la volontà della persona giuridica (organizzazione) e ad imputarle l’atto (con i relativi effetti) posto in essere dal suo titolare (persona fisica)."@it ;
           rdfs:label "Organo"@it .


###  https://w3id.org/italia/Parlamento/OrganoCollegiale
odp:OrganoCollegiale rdf:type owl:Class ;
                     owl:disjointWith odp:OrganoMonocratico ;
                     rdfs:comment "Ufficio composto da una pluralità di persone e qualificato da una norma dell’ordinamento giuridico come idoneo ad esprimere la volontà dell'organizzazione cui appartiene e ad imputarle gli atti (con i relativi effetti) posti in essere collegialmente dai componenti dell’organo (persone fisiche)."@it ;
                     rdfs:label "Organo collegiale"@it .


###  https://w3id.org/italia/Parlamento/OrganoCollegialeElettivo
odp:OrganoCollegialeElettivo rdf:type owl:Class ;
                             rdfs:subClassOf odp:OrganoCollegiale ;
                             rdfs:comment "Organo collegiale i cui componenti vengono nominati per elezione."@it ;
                             rdfs:label "Organo collegiale elettivo"@it .


###  https://w3id.org/italia/Parlamento/OrganoComplesso
odp:OrganoComplesso rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty odp:èCompostoDa ;
                                          owl:someValuesFrom owl:Thing
                                        ] ;
                    rdfs:subClassOf odp:Organo ;
                    rdfs:comment "Organo composto da altri organi (monocratici e/o complessi)."@it ;
                    rdfs:label "Organo complesso"@it .


###  https://w3id.org/italia/Parlamento/OrganoComplessoNelPeriodo
odp:OrganoComplessoNelPeriodo rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Restriction ;
                                                    owl:onProperty odp:haPeriodoDiOrganoComplesso ;
                                                    owl:someValuesFrom owl:Thing
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty odp:includeOrganoNelPeriodo ;
                                                    owl:someValuesFrom owl:Thing
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty [ owl:inverseOf odp:haOrganoComplessoNelPeriodo
                                                                   ] ;
                                                    owl:someValuesFrom owl:Thing
                                                  ] ;
                              rdfs:label "Organo complesso nel periodo"@it .


###  https://w3id.org/italia/Parlamento/OrganoCostituzionale
odp:OrganoCostituzionale rdf:type owl:Class ;
                         owl:disjointWith odp:OrganoParlamentare ;
                         rdfs:comment "Organo necessario dello Stato direttamente previsto e disciplinato dalla Costituzione."@it ;
                         rdfs:label "Organo costituzionale"@it .


###  https://w3id.org/italia/Parlamento/OrganoMonocratico
odp:OrganoMonocratico rdf:type owl:Class ;
                      rdfs:comment "Ufficio composto da un unico titolare, qualificato da una norma dell’ordinamento giuridico come idoneo ad esprimere la volontà della persona giuridica (organizzazione) e ad imputarle l’atto (con i relativi effetti) posto in essere dal suo titolare (persona fisica)."@it ;
                      rdfs:label "Organo monocratico"@it .


###  https://w3id.org/italia/Parlamento/OrganoMonocraticoElettivo
odp:OrganoMonocraticoElettivo rdf:type owl:Class ;
                              rdfs:subClassOf odp:OrganoMonocratico ;
                              rdfs:comment "Ufficio composto da un unico titolare nominato per elezione. "@it ;
                              rdfs:label "Organo monocratico elettivo"@it .


###  https://w3id.org/italia/Parlamento/OrganoParlamentare
odp:OrganoParlamentare rdf:type owl:Class ;
                       rdfs:comment "Ufficio qualificato dalla Costituzione o dai regolamenti di Camera e Senato come idoneo ad esprimere la volontà della rispettiva camera parlamentare di appartenenza."@it ;
                       rdfs:label "Organo parlamentare"@it .


###  https://w3id.org/italia/Parlamento/Parere
odp:Parere rdf:type owl:Class ;
           rdfs:comment """Atto che esprime il giudizio su una determinata questione sottoposta al soggetto che lo emana. I pareri possono essere obbligatori. Il parere è di norma espresso per iscritto; sono stampati in allegato alla relazione che la Commissione competente presenta all’Assemblea (Art. 40, c. 7 Reg. S.). (Art. 39, c. 3 Reg. S.). Esempi di parere: 
-Parere di una commissione (in sede consultiva) stampato e allegato alla relazione scritta per l’Assemblea (Art. 73 c. 1-bis Reg. C.);
-Parere espresso dalla Commissione bilancio e programmazione, ovvero dalla Commissione affari costituzionali o dalla Commissione lavoro, è stampato e allegato alla relazione scritta per l’Assemblea. (Art. 74, c. 3 e art. 75, c. 2, 118-bis Reg. C.);
-Parere delle Commissioni su una proposta di legge: (Art. 38 Reg. S.)."""@it ;
           rdfs:label "Parere"@it .


###  https://w3id.org/italia/Parlamento/ParereObbligatorioSuPropostaLegge
odp:ParereObbligatorioSuPropostaLegge rdf:type owl:Class ;
                                      rdfs:subClassOf odp:ParereSuPropostaLegge ;
                                      rdfs:comment "Giudizio consultivo di una Commissione su una determinata materia legislativa previsto espressamente dai regolamenti parlamentari. (Artt. 74 – 75 Reg. C.; 40 Reg. S.) "@it ;
                                      rdfs:label "Parere obbligatorio su proposta legge"@it .


###  https://w3id.org/italia/Parlamento/ParereSuPropostaLegge
odp:ParereSuPropostaLegge rdf:type owl:Class ;
                          rdfs:comment "Atto che esprime il giudizio di una Commissione competente su una proposta di legge assegnata ad altra commissione (Artt. 38 Reg. S. e 73 Reg. C.)."@it ;
                          rdfs:label "Parere su proposta legge"@it .


###  https://w3id.org/italia/Parlamento/Parlamentare
odp:Parlamentare rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:unionOf ( odp:Deputato
                                                     odp:Senatore
                                                   )
                                     ] ;
                 rdfs:subClassOf odp:MembroDelCollegio ;
                 rdfs:comment "Membro della Camera o del Senato (che, collettivamente, compongono il Parlamento, art. 55 Cost.). Il parlamentare può essere un deputato (Camera) o un senatore (Senato)."@it ;
                 rdfs:label "Parlamentare"@it .


###  https://w3id.org/italia/Parlamento/PeriodoDiSedutaCollegioParlamentare
odp:PeriodoDiSedutaCollegioParlamentare rdf:type owl:Class ;
                                        rdfs:subClassOf TI:TimeIndexedEvent ;
                                        rdfs:label "Periodo di seduta collegio parlamentare"@it .


###  https://w3id.org/italia/Parlamento/PreferenzaDiVotazione
odp:PreferenzaDiVotazione rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                owl:onProperty [ owl:inverseOf odp:haPreferenzaDiVotazione
                                                               ] ;
                                                owl:someValuesFrom owl:Thing
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty odp:numeroVotiDiPreferenza ;
                                                owl:someValuesFrom rdfs:Literal
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty odp:soggettoDiPreferenza ;
                                                owl:someValuesFrom rdfs:Literal
                                              ] ;
                          rdfs:label "Preferenza di votazione"@it .


###  https://w3id.org/italia/Parlamento/PresidenteCommissioneParlamentare
odp:PresidenteCommissioneParlamentare rdf:type owl:Class ;
                                      rdfs:comment "Organo della commissione parlamentare che la rappresenta, la convoca formandone l'ordine del giorno, ne presiede le sedute; ne convoca l'ufficio di presidenza (art. 21 reg.C., art. 29 reg.S.)."@it ;
                                      rdfs:label "Presidente commissione parlamentare"@it .


###  https://w3id.org/italia/Parlamento/PresidenteDelCollegio
odp:PresidenteDelCollegio rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                owl:onProperty [ owl:inverseOf odp:haPresidenteDelCollegio
                                                               ] ;
                                                owl:someValuesFrom owl:Thing
                                              ] ;
                          rdfs:subClassOf odp:MembroDelCollegio ;
                          rdfs:comment "Organo monocratico di organo collegiale cui spettano determinate funzioni previste da disposizioni di legge o di regolamento spesso connesse allo svolgimento dei lavori dell’organo collegiale."@it ;
                          rdfs:label "Presidente del collegio"@it .


###  https://w3id.org/italia/Parlamento/PresidenteDelSenato
odp:PresidenteDelSenato rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty odp:dataNominaPresidenteSenato ;
                                              owl:someValuesFrom rdfs:Literal
                                            ] ;
                        rdfs:subClassOf odp:Senatore ;
                        owl:disjointWith odp:PresidenteDellaCamera ;
                        rdfs:comment "Organo monocratico del Senato eletto con votazione a scrutinio segreto (art. 4 reg.S.) che rappresenta il Senato e regola l’attività dei suoi organi, dirige la discussione e mantiene l’ordine, giudica della ricevibilità dei testi, concede la facoltà di parlare, pone le questioni, stabilisce l’ordine delle votazioni e ne proclama i risultati. Sovrintende alle funzioni attribuite ai Questori ed ai Segretari. Assicura, impartendo le necessarie direttive, il buon andamento dell’Amministrazione del Senato (artt. 68 Cost., 8 reg.S.)."@it ;
                        rdfs:label "Presidente del Senato"@it .


###  https://w3id.org/italia/Parlamento/PresidenteDellaCamera
odp:PresidenteDellaCamera rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                owl:onProperty odp:dataNominaPresidenteCamera ;
                                                owl:someValuesFrom rdfs:Literal
                                              ] ;
                          rdfs:subClassOf odp:Deputato ;
                          rdfs:comment """Organo monocratico della Camera eletto a scrutinio segreto che provvede a: rappresentare la Camera, assicurare il buon andamento dei suoi lavori facendo osservare il Regolamento; 
dare la parola, dirigere e moderare la discussione, mantenere l'ordine, porre le questioni, stabilire l'ordine delle votazioni, chiarire il significato del voto e annunziarne il risultato (artt. 63 Cost.; 8 reg.C.);
presiedere l’Assemblea, l’Ufficio di Presidenza, la Conferenza dei Presidenti di Gruppo, la Giunta per il regolamento (art. 16 reg.C.)."""@it ;
                          rdfs:label "Presidente della Camera"@it .


###  https://w3id.org/italia/Parlamento/PresidenteDellaRepubblica
odp:PresidenteDellaRepubblica rdf:type owl:Class ;
                              rdfs:subClassOf odp:TitolareOrganoMonocratico ;
                              rdfs:comment """Organo monocratico dello Stato, eletto a scrutinio segreto dal Parlamento in seduta comune integrato dai delegati delle Regioni, che provvede a:
- esercitare i poteri di cui all’art. 87 Cost., tra cui indire le elezioni e i referendum;
- sciogliere le Camere (art. 88 Cost.);
- promulgare le leggi con potere di rinvio (art. 73 Cost.);
- nominare il Presidente del Consiglio dei ministri (art. 92 Cost.);
- nominare 5 membri della Corte costituzionale (art. 135 Cost.);
- nominare 5 senatori a vita. Il numero complessivo dei senatori in carica nominati dal Presidente della Repubblica non può in alcun caso essere superiore a cinque. (art. 59 Cost.). 
Dura in carica sette anni (art. 85 Cost.) ed è rieleggibile."""@it ;
                              rdfs:label "Presidente della Repubblica"@it .


###  https://w3id.org/italia/Parlamento/PresidenteDiCollegioParlamentare
odp:PresidenteDiCollegioParlamentare rdf:type owl:Class ;
                                     rdfs:subClassOf odp:PresidenteDelCollegio ;
                                     rdfs:comment "Organo monocratico di organo collegiale parlamentare cui spettano determinate funzioni previste da disposizioni di legge o di regolamento spesso connesse allo svolgimento dei lavori dell’organo collegiale."@it ;
                                     rdfs:label "Presidente di collegio parlamentare"@it .


###  https://w3id.org/italia/Parlamento/PresidenteGiuntaParlamentare
odp:PresidenteGiuntaParlamentare rdf:type owl:Class ;
                                 rdfs:comment "Organo di una giunta parlamentare eletto nella prima riunione tra i propri componenti e ne dirige i lavori e la discussione."@it ;
                                 rdfs:label "Presidente giunta parlamentare"@it .


###  https://w3id.org/italia/Parlamento/PresidenteGruppoParlamentare
odp:PresidenteGruppoParlamentare rdf:type owl:Class ;
                                 owl:equivalentClass [ rdf:type owl:Class ;
                                                       owl:unionOf ( odp:PresidenteGruppoParlamentareCamera
                                                                     odp:PresidenteGruppoParlamentareSenato
                                                                   )
                                                     ] .


###  https://w3id.org/italia/Parlamento/PresidenteGruppoParlamentareCamera
odp:PresidenteGruppoParlamentareCamera rdf:type owl:Class ;
                                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                                             owl:onProperty [ owl:inverseOf odp:haPresidenteGruppoParlamentareCamera
                                                                            ] ;
                                                             owl:someValuesFrom owl:Thing
                                                           ] ;
                                       owl:disjointWith odp:PresidenteGruppoParlamentareSenato ;
                                       rdfs:comment "Organo del gruppo parlamentare nominato nella prima riunione (art. 15, comma 2, reg.C.) e che ha il potere di rappresentare il gruppo. "@it ;
                                       rdfs:label "Presidente gruppo parlamentare camera"@it .


###  https://w3id.org/italia/Parlamento/PresidenteGruppoParlamentareSenato
odp:PresidenteGruppoParlamentareSenato rdf:type owl:Class ;
                                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                                             owl:onProperty [ owl:inverseOf odp:haAssembleaGruppoParlamentareSenato
                                                                            ] ;
                                                             owl:someValuesFrom owl:Thing
                                                           ] ;
                                       rdfs:comment "Organo del gruppo parlamentare nominato nella prima riunione (art. 15, comma 2, reg.S.) e che ha il potere di rappresentare il gruppo. Il presidente di gruppo può presentare questioni pregiudiziali o sospensive su progetti di legge di conversione di decreti legge (art.78, comma 3, reg.S)."@it ;
                                       rdfs:label "Presidente gruppo parlamentare senato"@it .


###  https://w3id.org/italia/Parlamento/PresidenzaSedutaCollegioParlamentare
odp:PresidenzaSedutaCollegioParlamentare rdf:type owl:Class ;
                                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                                               owl:onProperty [ owl:inverseOf odp:presiedeSedutaCollegioParlamentare
                                                                              ] ;
                                                               owl:someValuesFrom owl:Thing
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty [ owl:inverseOf odp:èPresiedutaDa
                                                                              ] ;
                                                               owl:someValuesFrom owl:Thing
                                                             ] ;
                                         rdfs:subClassOf TI:TimeIndexedEvent ;
                                         rdfs:comment "Organo monocratico che dirige i lavori di una seduta del Collegio Parlamentare."@it ;
                                         rdfs:label "Presidenza seduta collegio parlamentare"@it .


###  https://w3id.org/italia/Parlamento/PrimaLettura
odp:PrimaLettura rdf:type owl:Class ;
                 owl:disjointWith odp:UltimaLettura ;
                 rdfs:comment "Primo esame della proposta di legge da parte di una delle due Camere."@it ;
                 rdfs:label "Prima lettura"@it .


###  https://w3id.org/italia/Parlamento/ProceduraParlamentare
odp:ProceduraParlamentare rdf:type owl:Class ;
                          rdfs:comment "Procedura relativa allo svolgimento delle attività di una delle due Camere parlamentari o del Parlamento in seduta comune."@it ;
                          rdfs:label "Procedura parlamentare"@it .


###  https://w3id.org/italia/Parlamento/ProcessoVerbale
odp:ProcessoVerbale rdf:type owl:Class ;
                    rdfs:comment "Documento redatto per ogni seduta dell’assemblea e delle commissioni che contiene gli atti e le deliberazioni. Esso indica per le discussioni l’oggetto e i nomi di coloro che hanno partecipato (Art. 60 Reg. S.; Art. 34 Reg. C.)"@it ;
                    rdfs:label "Processo verbale"@it .


###  https://w3id.org/italia/Parlamento/ProgrammaDeiLavori
odp:ProgrammaDeiLavori rdf:type owl:Class ;
                       rdfs:comment "Documento predisposto sulla base delle indicazioni del Governo e delle proposte dei Gruppi, contiene l’elenco degli argomenti che le Camere intendono esaminare, con l’indicazione dell’ordine di priorità e del periodo nel quale se ne prevede l’iscrizione all’ordine dell’Assemblea. (Art. 23, Reg. C. – Art. 53 Reg. S.)"@it ;
                       rdfs:label "Programma dei lavori"@it .


###  https://w3id.org/italia/Parlamento/Proponente
odp:Proponente rdf:type owl:Class ;
               rdfs:subClassOf skos:Concept ;
               rdfs:label "Proponente"@it .


###  https://w3id.org/italia/Parlamento/PropostaDiLegge
odp:PropostaDiLegge rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty odp:haFirmatario ;
                                          owl:someValuesFrom owl:Thing
                                        ] ;
                    rdfs:comment "Atto di iniziativa legislativa di uno (o più) senatori o di uno (o più) deputati o del Governo o del CNEL o del popolo o del Consiglio regionale composto da un articolato normativo con relazione illustrativa presentato alla Presidenza di una delle due Camere per l’assegnazione alla Commissione competente (art. 71 e 72 Cost.)"@it ;
                    rdfs:label "Proposta di legge"@it .


###  https://w3id.org/italia/Parlamento/PropostaDiLeggeApprovata
odp:PropostaDiLeggeApprovata rdf:type owl:Class ;
                             owl:disjointWith odp:PropostaDiLeggeRinviata ;
                             rdfs:comment "Proposta di legge approvata da un ramo del Parlamento"@it ;
                             rdfs:label "Proposta di legge approvata"@it .


###  https://w3id.org/italia/Parlamento/PropostaDiLeggeApprovataConModificazioni
odp:PropostaDiLeggeApprovataConModificazioni rdf:type owl:Class ;
                                             rdfs:comment "Proposta di legge approvata con emendamenti rispetto alla versione presentata o trasmessa ad una delle Camere."@it ;
                                             rdfs:label "Proposta di legge approvata con modificazioni"@it .


###  https://w3id.org/italia/Parlamento/PropostaDiLeggeApprovataDefinitivamente
odp:PropostaDiLeggeApprovataDefinitivamente rdf:type owl:Class ;
                                            rdfs:comment "Proposta di legge approvata da entrambi i rami del Parlamento da trasmettere al Presidente della Repubblica per la successiva promulgazione e pubblicazione in Gazzetta Ufficiale."@it ;
                                            rdfs:label "Proposta di legge approvata definitivamente"@it .


###  https://w3id.org/italia/Parlamento/PropostaDiLeggeAssegnataInCommissione
odp:PropostaDiLeggeAssegnataInCommissione rdf:type owl:Class ;
                                          owl:disjointWith odp:PropostaDiLeggeRiassegnataInCommissione ;
                                          rdfs:comment "Proposta di legge assegnata alle commissioni competenti per materia da parte del Presidente di Camera o Senato (Artt. 72 Reg. C., 34, 35, 36 Reg. S.). Un disegno di legge o affare può essere assegnato a più Commissioni per l’esame o la deliberazione in comune (Art. 34,c. 2 Reg. S.)."@it ;
                                          rdfs:label "Proposta di legge assegnata in commissione"@it .


###  https://w3id.org/italia/Parlamento/PropostaDiLeggeInCorsoDiEsameInCommissione
odp:PropostaDiLeggeInCorsoDiEsameInCommissione rdf:type owl:Class ;
                                               rdfs:comment "Proposta di legge in esame presso le Commissioni in sede referente, deliberante legislativa, redigente e consultiva."@it ;
                                               rdfs:label "Proposta di legge in corso di esame in commissione"@it .


###  https://w3id.org/italia/Parlamento/PropostaDiLeggeInLettura
odp:PropostaDiLeggeInLettura rdf:type owl:Class ;
                             rdfs:comment "Proposta di legge in corso di esame e discussione presso una delle due Camere."@it ;
                             rdfs:label "Proposta di legge in lettura"@it .


###  https://w3id.org/italia/Parlamento/PropostaDiLeggeRiassegnataInCommissione
odp:PropostaDiLeggeRiassegnataInCommissione rdf:type owl:Class ;
                                            rdfs:comment "Proposta di legge già esaminata in commissione, trasmessa all’assemblea parlamentare per l’approvazione e ritrasmessa dall’assemblea parlamentare ad una commissione per un suo ulteriore esame."@it ;
                                            rdfs:label "Proposta di legge riassegnata in commissione"@it .


###  https://w3id.org/italia/Parlamento/PropostaDiLeggeRimessaAdAssemblea
odp:PropostaDiLeggeRimessaAdAssemblea rdf:type owl:Class ;
                                      rdfs:comment "Rimesso all'esame dell'Assemblea (stato non concluso)"@it ;
                                      rdfs:label "Proposta di legge rimessa ad assemblea"@it .


###  https://w3id.org/italia/Parlamento/PropostaDiLeggeRinviata
odp:PropostaDiLeggeRinviata rdf:type owl:Class ;
                            rdfs:subClassOf [ rdf:type owl:Restriction ;
                                              owl:onProperty odp:haStatoDiPropostaDiLeggePrecedente ;
                                              owl:someValuesFrom odp:PropostaDiLeggeApprovataDefinitivamente
                                            ] ;
                            rdfs:comment """Proposta di legge già approvata definitivamente da entrambe le Camere parlamentari, trasmessa al Presidente della Repubblica per la promulgazione e da questi rinviata alle Camere con messaggio motivato a norma dell’articolo 74 Cost.
Quando il Presidente della Repubblica chiede alle Camere una nuova deliberazione sopra un progetto di legge già approvato, il riesame di questo inizia presso quella Camera che in precedenza lo ha approvato per prima. (Artt. 71 Reg. C. e 136 Reg. S.)."""@it ;
                            rdfs:label "Proposta di legge rinviata"@it .


###  https://w3id.org/italia/Parlamento/Regione
odp:Regione rdf:type owl:Class ;
            rdfs:comment """Ente territoriale autonomo rappresentativo di una collettività stanziata su un determinato territorio, dotato di propri poteri e funzioni e di un ordinamento autonomo secondo i principî fissati dalla Costituzione (art. 114 Cost.)
Lo Stato italiano è diviso in 20 regioni, di cui 5 sono dotate di uno statuto speciale di autonomia (art. 116 Cost.), tra queste il Trentino-Alto Adige e la Valle d'Aosta, nel rispetto delle minoranze linguistiche, sono riportate con le denominazioni bilingue di Trentino-Alto Adige/Südtirol e Valle d'Aosta/Vallée d'Aoste."""@it ;
            rdfs:label "Regione"@it .


###  https://w3id.org/italia/Parlamento/Relatore
odp:Relatore rdf:type owl:Class ;
             rdfs:subClassOf odp:Parlamentare ;
             rdfs:comment """Parlamentare nominato per riferire relativamente a una determinata attività parlamentare: 
- r. progetto di legge (ddl) presso Comitato per la legislazione (art. 16 bis reg.C., 20 bis reg.S.), di commissione consultiva (artt. 73, 120, 124, 126 ter reg.C.), di commissione referente (artt. 79, c. 3 e 12, 80 reg.C., 43 reg.S.), di minoranza e di maggioranza referente (artt. 79, c.12, 86 e 87 reg.C.), in Assemblea (art. 100 reg.S.), di commissione deliberante/legislativa (artt. 94 reg.C.,), di commissione redigente (art. 96 reg.C., 42 reg.S.), di commissione redigente in Assemblea (art. 86 reg.C.), di ddl bilancio in Assemblea (art. 129 reg.S.); di ddl europea (art. 144 bis reg.S.).
- r. Giunta autorizzazioni (artt. 18 e 18 ter reg.C., 135 bis reg.S.);
- r. sentenze C. cost. e Corte giustizia (artt. 108 e 127 bis reg.C.)."""@it ;
             rdfs:label "Relatore"@it .


###  https://w3id.org/italia/Parlamento/RelatoreDiMaggioranza
odp:RelatoreDiMaggioranza rdf:type owl:Class ;
                          owl:disjointWith odp:RelatoreDiMinoranza ;
                          rdfs:comment "Componente di Commissione parlamentare designato dalla Commissione per riferire all’Assemblea di appartenenza (Camera o Senato) sul testo della proposta di legge predisposta dalla Commissione in sede referente (art. 79, c.12, reg.C.; art. 43, c.4, reg.S.)."@it ;
                          rdfs:label "Relatore di maggioranza"@it .


###  https://w3id.org/italia/Parlamento/RelatoreDiMinoranza
odp:RelatoreDiMinoranza rdf:type owl:Class ;
                        rdfs:comment "Componente di Commissione designato dai Gruppi dissenzienti al termine della discussione della proposta presso la Commissione competente. Ciascuna relazione di minoranza reca un proprio testo, anche parzialmente alternativo al testo della Commissione, formulato in articoli corrispondenti a quest'ultimo (Art. 79, c. 12, Reg. C.). Anche al Senato è sempre ammessa la presentazione di relazioni di minoranza. Il relatore di minoranza può integrare oralmente la propria relazione (Art. 43, c. 7, Reg. S.)."@it ;
                        rdfs:label "Relatore di minoranza"@it .


###  https://w3id.org/italia/Parlamento/Relazione
odp:Relazione rdf:type owl:Class ;
              rdfs:comment """Atto che esprime la posizione assunta su una determinata questione da soggetto che la adotta. Ad esempio: 
-Relazione della commissione sulla Proposta di legge: documento della Commissione che trasmette all’Assemblea un testo di Proposta di legge destinato ad essere preso come base della trattazione della Proposta di legge nel suo corso innanzi all’Assemblea. (Artt. 73, c. 1-bis e 4; 74, c. 3; 75, c. 2, 79, c. 14 Reg. C; Artt. 39, c. 4; 40, c. 7; 42, c.4; 44 Reg. S.)
-Relazione di minoranza: documento predisposto dai gruppi dissenzienti rispetto all’approvazione di un testo di Proposta di legge, anche parzialmente alternativo al testo della Commissione (Art. 79, c. 12 Reg. C.; Art. 46 c. 6 Reg. S.).
-Relazioni dei Comitati istituiti dalle Commissioni permanenti per l’esame degli affari di loro competenza (Art 22, c. 4 Reg. C)."""@it ;
              rdfs:label "Relazione"@it .


###  https://w3id.org/italia/Parlamento/Resoconto
odp:Resoconto rdf:type owl:Class ;
              rdfs:comment """Documento parlamentare nel quale sono riportati nella loro interezza le discussioni e le deliberazioni o, più in generale, gli accadimenti, delle sedute dell’assemblea o delle commissioni (Artt. 63, c. 2; 65, c. 1 – 2 Reg. C.; Artt. 33 c. 1 – 2; 60, c. 5 Reg. S.). Alla pubblicità dei lavori delle Giunte e delle Commissioni, nonché del Comitato per la legislazione, si provvede mediante resoconti pubblicati nel “Bollettino delle Giunte e delle Commissioni parlamentari” (Art. 65 Reg. C.). 
I resoconti si suddividono in:
- Resoconto stenografico: Documento che riporta in modo integrale le parole pronunciate durante le sedute dell’Assemblea e delle Commissioni (sedute in sede deliberante o redigente), nonché negli altri casi previsti dai regolamenti, con la funzione di trascrivere fedelmente e per intero gli interventi orali. (Artt. 63, c. 2; 65, c. 1 – 2 Reg. C.; Artt. 33 c. 1 – 2; 48 c. 6; 60, c. 5; 126; 152 Reg. S.). 
-Resoconto sommario: documento complementare al resoconto stenografico, che restituisce il contenuto degli interventi in forma sintetica, senza riportare testualmente l’intero discorso (Artt. 63, c. 2; 65, c. 1 – 2 Reg. C.). Riguarda tutte le sedute dell’Assemblea, delle Commissioni e delle Giunte della Camera."""@it ;
              rdfs:label "Resoconto"@it .


###  https://w3id.org/italia/Parlamento/Risoluzione
odp:Risoluzione rdf:type owl:Class ;
                rdfs:comment "Espressione del pensiero e degli indirizzi che ne derivano in ordine all’argomento in discussione (art. 50 Reg. S.). Le risoluzioni possono essere adottate dall’Assemblea parlamentare (art. 105, 144-bis Reg. S. artt. 117, c. 3, 118, 118-bis, 125, 126-ter, 149, 150 Reg. C.) o da una Commissione parlamentare (artt. 50, 138, 139, 144, 144-ter Reg.S; artt. 109, 117, c. 1, 125, 149, 150 Reg. C.)."@it ;
                rdfs:label "Risoluzione"@it .


###  https://w3id.org/italia/Parlamento/SedeConsultiva
odp:SedeConsultiva rdf:type owl:Class ;
                   rdfs:comment "Commissione parlamentare che fornisce un parere su un progetto di legge assegnato ad altra commissione (artt. 73 reg.C., 28 reg.S.) o, comunque, su una questione rientrante nel proprio ambito di competenza."@it ;
                   rdfs:label "Sede consultiva"@it .


###  https://w3id.org/italia/Parlamento/SedeLegislativaDeliberante
odp:SedeLegislativaDeliberante rdf:type owl:Class ;
                               rdfs:comment """I regolamenti di Camera e Senato si riferiscono alla medesima funzione della Commissione definendola rispettivamente “legislativa” (art. 92 reg.C.) e \"deliberante” (art. 35 reg.S.): 
Commissione della Camera (permanente o speciale) alla quale, da parte dell’Assemblea su proposta del Presidente, viene assegnato un progetto di legge (riguardante questioni che non hanno speciale rilevanza di ordine generale o che rivestano particolare urgenza) per l’esame e l’approvazione. È possibile il trasferimento di funzioni dalla sede referente alla sede legislativa/deliberante.
Per i progetti di legge in materia costituzionale ed elettorale e per quelli di delegazione legislativa, autorizzazione a ratificare trattati internazionali, approvazione di bilanci e consuntivi, una commissione non può procedere in sede legislativa/deliberante. (art. 72, c. 4 Cost.). """@it ;
                               rdfs:label "Sede legislativa deliberante"@it .


###  https://w3id.org/italia/Parlamento/SedeRedigente
odp:SedeRedigente rdf:type owl:Class ;
                  rdfs:comment """Commissione permanente o speciale cui è deferita, da parte dell'Assemblea (alla Camera dei deputati, art. 96 reg.C.) ovvero del Presidente (al Senato, art. 36 reg. S.) prima di passare all'esame degli articoli, la formulazione degli articoli di un progetto di legge; in questo caso, all’Assemblea è riservata l'approvazione (senza dichiarazioni di voto alla Camera e con sole dichiarazioni di voto al Senato) dei singoli articoli, nonché l'approvazione finale del progetto di legge con dichiarazioni di voto (artt. 96 reg.C., 36 reg.S.). 
Sono esclusi i progetti di legge in materia costituzionale ed elettorale e a quelli di delegazione legislativa, di autorizzazione a ratificare trattati internazionali, di approvazione di bilanci e consuntivi (art. 96 reg.C.)."""@it ;
                  rdfs:label "Sede redigente"@it .


###  https://w3id.org/italia/Parlamento/SedeReferente
odp:SedeReferente rdf:type owl:Class ;
                  rdfs:comment """Commissione parlamentare che si riunisce per l'esame delle questioni e dei progetti di legge assegnati sui quali deve riferire all’Assemblea (art. 22 reg.C.).
Un progetto di legge assegnato in sede referente può essere trasferito in sede deliberante (art. 92 reg.C.) o redigente (art. 37 reg.S). 
Il procedimento per l'esame dei progetti di legge in sede referente è costituito dall'esame preliminare con l'acquisizione dei necessari elementi informativi, dalla formulazione del testo degli articoli e dalla deliberazione sul conferimento del mandato a riferire all'Assemblea (art. 79 reg.C.)."""@it ;
                  rdfs:label "Sede referente"@it .


###  https://w3id.org/italia/Parlamento/SedutaCollegioParlamentare
odp:SedutaCollegioParlamentare rdf:type owl:Class ;
                               rdfs:subClassOf odp:PeriodoDiSedutaCollegioParlamentare ;
                               rdfs:comment """Riunione dei membri dell’Assemblea (Camera, Senato o Parlamento in seduta comune) o di una commissione parlamentare o di una giunta.
Una seduta può essere pubblica o segreta; ha una data, un ordine del giorno, un processo verbale o un riassunto dei lavori o un resoconto stenografico (artt. 34 reg.C., 33 reg.S.); le sedute hanno un numero (art. 55 reg.S.)."""@it ;
                               rdfs:label "Seduta collegio parlamentare"@it .


###  https://w3id.org/italia/Parlamento/Senato
odp:Senato rdf:type owl:Class ;
           rdfs:comment """Organo collegiale del Parlamento cui spetta, collettivamente e alla pari con la Camera dei deputati, l’esercizio del potere legislativo (art. 70 Cost.) ovvero poteri di indirizzo, di controllo, di inchiesta e di natura giurisdizionale. Il Senato della Repubblica è eletto a base regionale, salvi i seggi assegnati alla circoscrizione Estero. Il numero dei senatori elettivi a suffragio universale e diretto è di duecento, quattro dei quali eletti nella circoscrizione Estero. (artt. 57 e 58 Cost.).
Il Senato è eletto per cinque anni (art. 60 Cost.)."""@it ;
           rdfs:label "Senato"@it .


###  https://w3id.org/italia/Parlamento/Senatore
odp:Senatore rdf:type owl:Class ;
             rdfs:comment "Parlamentare membro del Senato votato con elezione a suffragio universale e diretto il cui mandato coincide con la durata della legislatura rispetto alla quale viene eletto."@it ;
             rdfs:label "Senatore"@it .


###  https://w3id.org/italia/Parlamento/SenatoreAVita
odp:SenatoreAVita rdf:type owl:Class ;
                  rdfs:subClassOf odp:Senatore ;
                  rdfs:comment """Parlamentare membro del Senato:
- di diritto, salvo rinunzia, ex Presidenti della Repubblica. - cittadino nominato dal Presidente della Repubblica per altissimi meriti nel campo sociale, scientifico, artistico e letterario. 
Decade solo per decesso e rinuncia, oltre agli casi di destituzione previsti dalla legge.
Il numero complessivo dei senatori in carica nominati dal Presidente della Repubblica non può in alcun caso essere superiore a cinque. (art. 59 Cost.)"""@it ;
                  rdfs:label "Senatore a vita"@it .


###  https://w3id.org/italia/Parlamento/SettoreDiCompetenza
odp:SettoreDiCompetenza rdf:type owl:Class ;
                        rdfs:subClassOf skos:Concept ;
                        rdfs:label "Settore di competenza"@it .


###  https://w3id.org/italia/Parlamento/StatoPropostaDiLegge
odp:StatoPropostaDiLegge rdf:type owl:Class ;
                         rdfs:label "Stato proposta di legge"@it .


###  https://w3id.org/italia/Parlamento/Teseo
odp:Teseo rdf:type owl:Class ;
          rdfs:subClassOf skos:Concept ;
          rdfs:label "Teseo"@it .


###  https://w3id.org/italia/Parlamento/TestoPropostaLegge
odp:TestoPropostaLegge rdf:type owl:Class ;
                       rdfs:comment "Testo della Proposta di legge; si compone di: - intestazione (copertina), - relazione del proponente, - testo normativo redatto in articoli composti da commi; – eventuali annessi e allegati. "@it ;
                       rdfs:label "Testo proposta legge"@it .


###  https://w3id.org/italia/Parlamento/TipoDiAttoParlamentare
odp:TipoDiAttoParlamentare rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty [ owl:inverseOf odp:haTipoDiDocumento
                                                                ] ;
                                                 owl:someValuesFrom odp:AttoParlamentare
                                               ] ;
                           rdfs:subClassOf odp:TipoDiDocumento ;
                           rdfs:label "Tipo di atto parlamentare"@it .


###  https://w3id.org/italia/Parlamento/TipoDiDocumento
odp:TipoDiDocumento rdf:type owl:Class ;
                    rdfs:label "Tipo di documento"@it .


